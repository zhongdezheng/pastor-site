---
import countries from '../data/countries.json';

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;

const labels = {
  en: {
    title: 'Prayer Requests',
    subtitle: 'Your prayers light up the world. Every dot represents a heart crying out to God.',
    name: 'Name', namePlaceholder: 'Your name (optional)',
    email: 'Email', emailPlaceholder: 'your@email.com',
    country: 'Your Country', countryPlaceholder: 'e.g. Kenya, Nigeria, China...',
    request: 'Prayer Request', requestPlaceholder: 'Share what\'s on your heart...',
    submit: 'Send Prayer', submitting: 'Sending...',
    successTitle: 'Thank You', successMsg: 'Your prayer has been received. A light now shines for your nation.',
    errorMsg: 'Something went wrong. Please try again.',
    required: 'Please fill in your country and prayer request.',
  },
  zh: {
    title: '代祷需求',
    subtitle: '你的祷告点亮世界。每一个光点代表一颗呼求上帝的心。',
    name: '姓名', namePlaceholder: '你的名字（选填）',
    email: '邮箱', emailPlaceholder: '你的邮箱',
    country: '你的国家', countryPlaceholder: '例如：中国、美国、肯尼亚...',
    request: '代祷事项', requestPlaceholder: '分享你心中所想...',
    submit: '发送代祷', submitting: '发送中...',
    successTitle: '感谢你', successMsg: '你的代祷已收到。一束光正为你的国家亮起。',
    errorMsg: '提交失败，请重试。',
    required: '请填写国家和代祷事项。',
  },
};
const t = labels[lang];

const countriesJSON = JSON.stringify(countries);
const labelsJSON = JSON.stringify(t);
---

<section id="prayer" class="py-24 lg:py-32 px-4 sm:px-6 bg-beige-50 overflow-hidden">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title text-charcoal-900">{t.title}</h2>
    <p class="section-subtitle mb-8">{t.subtitle}</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div class="relative flex justify-center">
        <div id="globe-container" class="w-full aspect-square max-w-[440px]" style="cursor:grab"></div>
        <p id="prayer-counter" class="absolute bottom-0 left-1/2 -translate-x-1/2 text-xs text-charcoal-400 font-medium tracking-wide">
          &#x2728; {lang === 'en' ? 'Prayers around the world' : '世界各地的祷告'}
        </p>
      </div>

      <div class="max-w-md mx-auto w-full">
        <form id="prayer-form" class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-5 border border-beige-200">
          <div>
            <label class="block text-sm font-medium text-charcoal-600 mb-1.5">{t.name}</label>
            <input type="text" name="name" placeholder={t.namePlaceholder} class="w-full px-4 py-2.5 rounded-xl border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent transition-all text-charcoal-800 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-charcoal-600 mb-1.5">{t.email}</label>
            <input type="email" name="email" placeholder={t.emailPlaceholder} class="w-full px-4 py-2.5 rounded-xl border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent transition-all text-charcoal-800 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-charcoal-600 mb-1.5">{t.country} *</label>
            <input type="text" name="country" required placeholder={t.countryPlaceholder} autocomplete="off" list="country-list" class="w-full px-4 py-2.5 rounded-xl border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent transition-all text-charcoal-800 text-sm" />
            <datalist id="country-list">
              {Object.keys(countries).map(c => <option value={c} />)}
            </datalist>
          </div>
          <div>
            <label class="block text-sm font-medium text-charcoal-600 mb-1.5">{t.request} *</label>
            <textarea name="request" rows="4" required placeholder={t.requestPlaceholder} class="w-full px-4 py-2.5 rounded-xl border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent transition-all text-charcoal-800 text-sm resize-none"></textarea>
          </div>
          <button type="submit" class="w-full py-3 bg-sage-500 hover:bg-sage-600 text-white font-medium rounded-xl transition-colors text-base">{t.submit}</button>
        </form>
        <div id="prayer-success" class="hidden mt-6 bg-sage-50 border border-sage-200 rounded-2xl p-6 text-center">
          <p class="text-4xl mb-3">&#x1F31F;</p>
          <h3 class="font-serif text-lg font-bold text-sage-800 mb-1">{t.successTitle}</h3>
          <p class="text-sage-600 text-sm">{t.successMsg}</p>
        </div>
        <div id="prayer-error" class="hidden mt-6 bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
          <p class="text-red-600 text-sm">{t.errorMsg}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #globe-container canvas { display: block; }
</style>

<!-- is:inline — bypass Vite bundling so Astro template vars work -->
<script is:inline>
  var PRAYER_COUNTRIES = {countriesJSON};
  var PRAYER_LABELS = {labelsJSON};
  var PRAYER_LANG = '{lang}';
</script>

<script is:inline>
(function() {
  var countryData = PRAYER_COUNTRIES;
  var tLabels = PRAYER_LABELS;
  var lang = PRAYER_LANG;
  var prayerDots = [];

  // Dynamically load Three.js
  var threeScript = document.createElement('script');
  threeScript.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
  threeScript.onload = init;
  document.head.appendChild(threeScript);

  function init() {
    var container = document.getElementById('globe-container');
    if (!container) return;
    if (container.getAttribute('data-inited')) return;
    container.setAttribute('data-inited', '1');

    var w = container.clientWidth;
    var h = container.clientHeight;
    if (w === 0 || h === 0) { setTimeout(init, 200); return; }

    var scene = new THREE.Scene();
    var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.domElement.style.pointerEvents = 'none';
    container.style.pointerEvents = 'auto';
    container.appendChild(renderer.domElement);

    var camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 100);
    camera.position.z = 6;

    var radius = 1.8;
    var globe = new THREE.Group();
    scene.add(globe);

    // Solid sphere
    var geo = new THREE.SphereGeometry(radius, 64, 64);
    var mat = new THREE.MeshPhongMaterial({ color: 0x8BA899, specular: 0x222222, shininess: 10, transparent: true, opacity: 0.15 });
    globe.add(new THREE.Mesh(geo, mat));

    // Wireframe
    var wGeo = new THREE.SphereGeometry(radius * 1.002, 36, 36);
    var wMat = new THREE.MeshBasicMaterial({ color: 0x6E8174, wireframe: true, transparent: true, opacity: 0.18 });
    globe.add(new THREE.Mesh(wGeo, wMat));

    // Orbit ring
    var rGeo = new THREE.TorusGeometry(radius * 1.25, 0.015, 16, 100);
    var rMat = new THREE.MeshBasicMaterial({ color: 0xB5A890, transparent: true, opacity: 0.3 });
    var ring = new THREE.Mesh(rGeo, rMat);
    ring.rotation.x = Math.PI / 2.5;
    globe.add(ring);

    // Lat/lon lines
    for (var lat = -60; lat <= 60; lat += 30) {
      var r = radius * Math.cos(lat * Math.PI / 180);
      var y = radius * Math.sin(lat * Math.PI / 180);
      var cGeo = new THREE.TorusGeometry(r, 0.012, 16, 64);
      var cMat = new THREE.MeshBasicMaterial({ color: 0xB5A890, transparent: true, opacity: 0.2 });
      var circle = new THREE.Mesh(cGeo, cMat);
      circle.position.y = y;
      globe.add(circle);
    }
    for (var lng = 0; lng < 180; lng += 30) {
      var lGeo = new THREE.TorusGeometry(radius, 0.012, 16, 64);
      var lMat = new THREE.MeshBasicMaterial({ color: 0xB5A890, transparent: true, opacity: 0.2 });
      var lRing = new THREE.Mesh(lGeo, lMat);
      lRing.rotation.y = lng * Math.PI / 180;
      globe.add(lRing);
    }

    // Lighting
    scene.add(new THREE.AmbientLight(0xFDFBF7, 1.5));
    var dl = new THREE.DirectionalLight(0xffffff, 1.2);
    dl.position.set(5, 3, 5);
    scene.add(dl);

    // Country dots
    var dg = new THREE.Group();
    globe.add(dg);
    var dGeo = new THREE.SphereGeometry(0.025, 8, 8);
    Object.keys(countryData).forEach(function(name) {
      var lat = countryData[name][0], lng = countryData[name][1];
      var phi = (90 - lat) * Math.PI / 180;
      var theta = (lng + 180) * Math.PI / 180;
      var x = -radius * Math.sin(phi) * Math.cos(theta);
      var y = radius * Math.cos(phi);
      var z = radius * Math.sin(phi) * Math.sin(theta);
      var dot = new THREE.Mesh(dGeo, new THREE.MeshBasicMaterial({ color: 0xC4B7A5, transparent: true, opacity: 0.5 }));
      dot.position.set(x, y, z);
      dg.add(dot);
    });

    // Add prayer glow
    window.addPrayerGlow = function(lat, lng) {
      var phi = (90 - lat) * Math.PI / 180;
      var theta = (lng + 180) * Math.PI / 180;
      var x = -radius * Math.sin(phi) * Math.cos(theta);
      var y = radius * Math.cos(phi);
      var z = radius * Math.sin(phi) * Math.sin(theta);

      var core = new THREE.Mesh(new THREE.SphereGeometry(0.04, 16, 16), new THREE.MeshBasicMaterial({ color: 0xF9F4EA, transparent: true, opacity: 1 }));
      core.position.set(x, y, z);
      globe.add(core);

      var halo = new THREE.Mesh(new THREE.SphereGeometry(0.08, 16, 16), new THREE.MeshBasicMaterial({ color: 0x6E8174, transparent: true, opacity: 0.7 }));
      halo.position.set(x, y, z);
      globe.add(halo);

      prayerDots.push(core, halo);

      var start = performance.now();
      (function fade(now) {
        var p = Math.min((now - start) / 10000, 1);
        core.material.opacity = 1 - p;
        halo.material.opacity = 0.7 * (1 - p);
        halo.scale.setScalar(1 + p * 2);
        if (p < 1) requestAnimationFrame(fade);
      })(start);

      var counter = document.getElementById('prayer-counter');
      if (counter) {
        var count = prayerDots.length / 2;
        counter.textContent = lang === 'zh' ? '\u2728 ' + count + ' \u4e2a\u56fd\u5bb6\u7684\u7977\u544a' : '\u2728 Prayers from ' + count + ' countries';
      }
    };

    // Interaction
    var dragging = false, px = 0, py = 0, rotX = 0.3, rotY = 0, tRx = rotX, tRy = rotY;

    container.addEventListener('mousedown', function(e) { dragging = true; px = e.clientX; py = e.clientY; container.style.cursor = 'grabbing'; });
    window.addEventListener('mouseup', function() { dragging = false; container.style.cursor = 'grab'; });
    window.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      var dx = e.clientX - px, dy = e.clientY - py;
      px = e.clientX; py = e.clientY;
      tRy += dx * 0.005; tRx += dy * 0.005;
      tRx = Math.max(-1.5, Math.min(1.5, tRx));
    });

    container.addEventListener('touchstart', function(e) {
      if (e.touches.length === 1) { dragging = true; px = e.touches[0].clientX; py = e.touches[0].clientY; }
    }, { passive: true });
    window.addEventListener('touchend', function() { dragging = false; });
    window.addEventListener('touchmove', function(e) {
      if (!dragging || e.touches.length !== 1) return;
      var dx = e.touches[0].clientX - px, dy = e.touches[0].clientY - py;
      px = e.touches[0].clientX; py = e.touches[0].clientY;
      tRy += dx * 0.005; tRx += dy * 0.005;
      tRx = Math.max(-1.5, Math.min(1.5, tRx));
    }, { passive: true });

    function animate() {
      requestAnimationFrame(animate);
      if (!dragging) tRy += 0.003;
      rotX += (tRx - rotX) * 0.08;
      rotY += (tRy - rotY) * 0.08;
      globe.rotation.x = rotX;
      globe.rotation.y = rotY;
      prayerDots.forEach(function(d, i) { d.scale.setScalar(1 + Math.sin(performance.now() * 0.005 + i) * 0.15); });
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', function() {
      var nw = container.clientWidth, nh = container.clientHeight;
      renderer.setSize(nw, nh);
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
    });
  }

  // Form
  function initForm() {
    var form = document.getElementById('prayer-form');
    if (!form || form.getAttribute('data-inited')) return;
    form.setAttribute('data-inited', '1');
    var success = document.getElementById('prayer-success');
    var error = document.getElementById('prayer-error');
    var btn = form.querySelector('button');

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var fd = new FormData(form);
      var country = (fd.get('country') || '').toString().trim();
      var request = (fd.get('request') || '').toString().trim();
      if (!country || !request) { alert(tLabels.required); return; }

      var found = '';
      var input = country.toLowerCase();
      if (countryData[country]) { found = country; }
      else {
        Object.keys(countryData).forEach(function(k) {
          if (k.toLowerCase() === input) found = k;
        });
      }
      if (!found) {
        Object.keys(countryData).forEach(function(k) {
          if (k.toLowerCase().includes(input) || input.includes(k.toLowerCase())) found = k;
        });
      }
      if (found && window.addPrayerGlow) {
        window.addPrayerGlow(countryData[found][0], countryData[found][1]);
      }

      var data = { name: fd.get('name') || '', email: fd.get('email') || '', country: country, request: request, lang: lang, timestamp: new Date().toISOString() };
      btn.textContent = tLabels.submitting;
      btn.classList.add('opacity-70');
      fetch('/api/prayer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function(r) { if (!r.ok) throw new Error('fail'); form.classList.add('hidden'); success.classList.remove('hidden'); error.classList.add('hidden'); })
        .catch(function() { error.classList.remove('hidden'); success.classList.add('hidden'); })
        .finally(function() { btn.textContent = tLabels.submit; btn.classList.remove('opacity-70'); });
    });
  }

  // Wait for container to have size, then initForm
  function readyCheck() {
    var c = document.getElementById('globe-container');
    if (c && c.clientWidth > 0) { initForm(); }
    else { setTimeout(readyCheck, 200); }
  }
  readyCheck();
})();
</script>
