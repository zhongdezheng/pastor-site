---
import heroData from '../content/hero.json';
interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
const t = heroData[lang];
const photos = [
  { src: '/images/hero-1.jpg', alt: 'Pastor Jeff' },
  { src: '/images/hero-2.jpg', alt: 'Ministry' },
  { src: '/images/hero-3.jpg', alt: 'Faith' },
  { src: '/images/hero-4.jpg', alt: 'Worship' },
];
---

<section id="hero" class="min-h-screen pt-8 flex items-center">
  <div class="max-w-7xl mx-auto px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center py-8 lg:py-12">
      <!-- Left: Text -->
      <div class="order-2 lg:order-1">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-charcoal-900 leading-tight mb-6">
          {t.name}
        </h1>
        <p class="text-lg text-charcoal-500 font-serif italic mb-8">{t.title}</p>
        <div class="space-y-4 text-charcoal-600 leading-relaxed max-w-lg mb-6">
          <p>{t.preview}</p>
        </div>
        <blockquote class="border-l-2 border-beige-400 pl-6 mb-6">
          <p class="text-charcoal-500 italic font-serif">{t.verse}</p>
          <cite class="text-sm text-charcoal-400 not-italic mt-2 block">{t.verseRef}</cite>
        </blockquote>
        <div class="text-right">
          <a href={`/${lang}/testimonies/`} class="inline-flex items-center gap-1 text-sage-500 hover:text-sage-600 font-medium text-sm transition-colors">
            {lang === 'en' ? 'Read More' : '更多'} <span class="text-lg">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right: Photo Carousel -->
      <div class="order-1 lg:order-2">
        <photo-carousel class="block relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-beige-200 shadow-xl">
          {photos.map((photo, i) => (
            <img
              src={photo.src}
              alt={photo.alt}
              class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              data-photo-index={i}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <!-- Dots -->
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
            {photos.map((_, i) => (
              <button
                class={`w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-6' : 'bg-white/50'}`}
                data-dot={i}
                aria-label={`Photo ${i + 1}`}
              ></button>
            ))}
          </div>
        </photo-carousel>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    var container = document.querySelector('photo-carousel');
    if (!container) return;
    var photos = container.querySelectorAll('[data-photo-index]');
    var dots = container.querySelectorAll('[data-dot]');
    if (photos.length < 2) return;
    var current = 0, interval;
    function show(idx){
      photos.forEach(function(p,i){
        p.classList.toggle('opacity-100', i===idx);
        p.classList.toggle('opacity-0', i!==idx);
      });
      dots.forEach(function(d,i){
        d.classList.toggle('bg-white', i===idx);
        d.classList.toggle('bg-white/50', i!==idx);
        d.classList.toggle('w-6', i===idx);
        d.classList.toggle('w-2.5', i!==idx);
      });
      current = idx;
    }
    function next(){ show((current+1) % photos.length); }
    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        show(parseInt(dot.getAttribute('data-dot')||'0'));
        clearInterval(interval);
        interval = setInterval(next, 5000);
      });
    });
    interval = setInterval(next, 5000);
    container.addEventListener('mouseenter', function(){ clearInterval(interval); });
    container.addEventListener('mouseleave', function(){ interval = setInterval(next, 5000); });
  })();
</script>
