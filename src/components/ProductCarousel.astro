---
import products from '../content/products.json';
import siteData from '../content/site.json';
const { site } = siteData;

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;

const labels = {
  en: { sizes:'Sizes', weight:'Weight', stock:'In Stock', outOfStock:'Out of Stock', addToCart:'Add to Cart', color:'Color', qty:'Qty', all:'All', clothing:'Clothing', jewelry:'Jewelry' },
  zh: { sizes:'尺码', weight:'克重', stock:'库存', outOfStock:'已售罄', addToCart:'加入购物车', color:'颜色', qty:'数量', all:'全部', clothing:'服装', jewelry:'首饰' },
};
const t = labels[lang];

const appProducts = products.filter(p => p.category === 'apparel');
const jewelryProducts = products.filter(p => p.category !== 'apparel');

// Duplicate product cards for seamless infinite scroll
const allProducts = products;
---

<section id="products" class="py-24 lg:py-32 px-4 sm:px-6 bg-white overflow-hidden">
  <div class="max-w-5xl mx-auto">

    <!-- Category filter buttons -->
    <div class="flex gap-3 mb-8">
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors bg-charcoal-800 text-white" data-cat="all">{t.all}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="apparel">{t.clothing}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="accessories">{t.jewelry}</button>
    </div>

    <!-- Product Carousel - Pure CSS scroll -->
    <div id="product-carousel" class="product-carousel relative select-none" style="height: 360px;">
      <div id="product-track" class="product-track overflow-hidden" style="position:relative; height:100%;">
        <div class="carousel-scroll-track flex items-start" id="scroll-inner" style="gap:14px;">
          {appProducts.map((p, pi) => {
            const pImages = p.images && p.images.length > 0 ? p.images : [null];
            return pImages.map((img, imgIdx) => (
            <div class="carousel-card-item shrink-0 bg-white rounded-2xl border border-beige-200 shadow-sm transition-all duration-300 cursor-pointer" data-index={pi * 10 + imgIdx} data-category={p.category} data-id={p.id} data-sid={pi * 10 + imgIdx} style="width:180px; min-height:300px;">
              <div class="aspect-square bg-beige-100 rounded-t-2xl flex items-center justify-center text-3xl relative overflow-hidden">
                {img ? <img src={img} alt="" class="w-full h-full object-cover" loading="lazy" /> : <span>👕</span>}
                {p.stock === 0 && <div class="absolute inset-0 bg-black/20 flex items-center justify-center"><span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded">{t.outOfStock}</span></div>}
              </div>
              <div class="p-3 flex flex-col flex-1">
                <h3 class="font-serif font-bold text-xs text-charcoal-800 mb-0.5 leading-tight">{p.name[lang]}</h3>
                <p class="text-charcoal-700 font-semibold text-sm mb-0.5">${p.price}</p>
                <p class="text-[10px] text-charcoal-400 mb-2">{t.weight}: {p.weight}</p>
                <div class="card-colors flex gap-0.5 mb-1">
                  {p.colors.map(c => {
                    const bg = c==='白色'?'#f0f0f0':c==='黑色'?'#222':c==='灰色'?'#999':c==='深蓝'?'#1e3a5f':c;
                    return <span class="inline-block w-3 h-3 rounded-full border border-charcoal-300" style={`background:${bg}`} title={c}></span>;
                  })}
                </div>
                <div class="card-sizes flex flex-wrap gap-0.5 mb-2">
                  {p.sizes.map(s => <span class="text-[9px] border border-charcoal-200 rounded px-1 py-0 text-charcoal-500">{s}</span>)}
                </div>
                <div class="mt-auto flex items-center justify-between">
                  <span class={`text-[10px] font-medium ${p.stock > 0 ? 'text-green-600' : 'text-red-400'}`}>{p.stock > 0 ? `${t.stock}: ${p.stock}` : t.outOfStock}</span>
                  <button class="carousel-add-cart px-2 py-1.5 bg-charcoal-800 text-white text-[10px] rounded-lg hover:bg-charcoal-700 transition-colors" data-product={p.id} data-name={p.name[lang]} data-price={p.price} disabled={p.stock===0} onclick="event.stopPropagation();return false;">{t.addToCart}</button>
                </div>
              </div>
            </div>
          ))}); })}
        </div>
      </div>

      <div class="absolute inset-y-0 left-0 w-12 md:w-24 pointer-events-none bg-gradient-to-r from-white/95 to-transparent z-10 rounded-l-2xl"></div>
      <div class="absolute inset-y-0 right-0 w-12 md:w-24 pointer-events-none bg-gradient-to-l from-white/95 to-transparent z-10 rounded-r-2xl"></div>

      <button id="prod-prev" class="absolute left-1 md:left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20">‹</button>
      <button id="prod-next" class="absolute right-1 md:right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20">›</button>
    </div>
  </div>
</section>

<style>
  .carousel-card-item.active-card {
    transform: scale(1.12) !important;
    box-shadow: 0 20px 60px rgba(120,100,80,0.15), 0 8px 20px rgba(120,100,80,0.08) !important;
    z-index: 5 !important;
  }
  .carousel-card-item.pop-in {
    animation: pop3d 0.5s cubic-bezier(0.34,1.56,0.64,1);
  }
  @keyframes pop3d {
    0% { transform:scale(0.9) perspective(800px) rotateY(15deg); }
    50% { transform:scale(1.15) perspective(800px) rotateY(-5deg); }
    100% { transform:scale(1.12) perspective(800px) rotateY(0deg); }
  }
  #scroll-inner { transition: none; }
</style>

<script type="application/json" id="__carouselData" set:html={JSON.stringify(allProducts.map(p=>({id:p.id,name:p.name[lang],price:p.price,colors:p.colors,sizes:p.sizes,category:p.category,stock:p.stock,image:p.images?p.images[0]:'',images:p.images||[]})))}></script>
<script is:inline>
  (function() {
    var ALLPRODS = JSON.parse(document.getElementById("__carouselData").textContent);
    var CURRCAT = 'all';
    var FILTERED = ALLPRODS.filter(function(p){ return CURRCAT==='all'||p.category===CURRCAT; });
    var track, inner, prevBtn, nextBtn;
    var scrollX = FILTERED.length * step - 200, speed = 1.2, paused = false, raf = null;
    var cardW = 180, gap = 14, step = cardW + gap;
    var activeIdx = 0;

    function init() {
      track = document.getElementById('product-track');
      inner = document.getElementById('scroll-inner');
      prevBtn = document.getElementById('prod-prev');
      nextBtn = document.getElementById('prod-next');
      if (!track || !inner) return;
      rebuildInner();
      startScroll();
    }

    function rebuildInner() {
      var triple = FILTERED.concat(FILTERED).concat(FILTERED);
      inner.innerHTML = triple.map(function(p, i) {
        var colorsHtml = (p.colors||[]).map(function(c) {
          var bg = c==='白色'?'#f0f0f0':c==='黑色'?'#222':c==='灰色'?'#999':c==='深蓝'?'#1e3a5f':c;
          return '<span class="inline-block w-3 h-3 rounded-full border border-charcoal-300" style="background:'+bg+'" title="'+c+'"></span>';
        }).join('');
        var sizesHtml = (p.sizes||[]).map(function(s) { return '<span class="text-[9px] border border-charcoal-200 rounded px-1 py-0 text-charcoal-500">'+s+'</span>'; }).join('');
        var sid = i % FILTERED.length;
        return '<div class="carousel-card-item shrink-0 bg-white rounded-2xl border border-beige-200 shadow-sm transition-all duration-300 cursor-pointer" data-index="'+sid+'" data-sid="'+i+'" data-id="'+p.id+'" data-category="'+p.category+'" style="width:'+cardW+'px; min-height:300px;">'+
          '<div class="aspect-square bg-beige-100 rounded-t-2xl flex items-center justify-center text-3xl relative overflow-hidden">'+(p.image?'<img src="'+p.image+'" alt="" class="w-full h-full object-cover" loading="lazy" style="object-position:center 20%" />':'<span>👕</span>')+(p.stock===0?'<div class="absolute inset-0 bg-black/20 flex items-center justify-center"><span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded">售罄</span></div>':'')+'</div>'+
          '<div class="p-3 flex flex-col flex-1"><h3 class="font-serif font-bold text-xs text-charcoal-800 mb-0.5 leading-tight">'+p.name+'</h3><p class="text-charcoal-700 font-semibold text-sm mb-0.5">$'+p.price+'</p>'+
          '<div class="card-colors flex gap-0.5 mb-1">'+colorsHtml+'</div>'+
          '<div class="card-sizes flex flex-wrap gap-0.5 mb-2">'+sizesHtml+'</div>'+
          '<div class="mt-auto flex items-center justify-between"><span class="text-[10px] font-medium '+(p.stock>0?'text-green-600':'text-red-400')+'">'+(p.stock>0?'库存:'+p.stock:'售罄')+'</span>'+
          '<button class="carousel-add-cart px-2 py-1.5 bg-charcoal-800 text-white text-[10px] rounded-lg hover:bg-charcoal-700 transition-colors" data-product="'+p.id+'" data-name="'+p.name+'" data-price="'+p.price+'">加入购物车</button></div></div></div>';
      }).join('');
      inner.style.gap = gap+'px';
    }

    function scroll(ts) {
      if (!paused) {
        scrollX += speed;
        var totalW = FILTERED.length * step;
        if (scrollX >= totalW) scrollX -= totalW;
        inner.style.transform = 'translateX(' + (-scrollX) + 'px)';
        // Find card closest to center
        var containerW = track.clientWidth;
        var center = containerW / 2;
        var bestIdx = -1, bestDist = Infinity;
        var cards = inner.querySelectorAll('.carousel-card-item');
        cards.forEach(function(card) {
          var rect = card.getBoundingClientRect();
          var cardCenter = rect.left + rect.width/2 - track.getBoundingClientRect().left;
          var d = Math.abs(cardCenter - center);
          if (d < bestDist) { bestDist = d; bestIdx = parseInt(card.dataset.index); }
        });
        if (bestIdx >= 0 && bestIdx !== activeIdx) {
          cards.forEach(function(c) { c.classList.remove('active-card','pop-in'); });
          var active = inner.querySelector('.carousel-card-item[data-index="'+bestIdx+'"]');
          if (active && bestDist < cardW * 0.6) {
            active.classList.add('active-card','pop-in');
            activeIdx = bestIdx;
          }
        }
      }
      raf = requestAnimationFrame(scroll);
    }

    function startScroll() { raf = requestAnimationFrame(scroll); }
    function stopScroll() { if (raf) { cancelAnimationFrame(raf); raf = null; } }

    function snapTo(idx) {
      scrollX = idx * step;
      var totalW = FILTERED.length * step;
      if (scrollX >= totalW) scrollX -= totalW;
      inner.style.transform = 'translateX(' + (-scrollX) + 'px)';
      inner.querySelectorAll('.carousel-card-item').forEach(function(c) { c.classList.remove('active-card','pop-in'); });
      var target = inner.querySelector('.carousel-card-item[data-sid="'+idx+'"]');
      if (target) {
        target.classList.add('active-card','pop-in');
        activeIdx = parseInt(target.dataset.index);
      }
    }

    prevBtn.onclick = function() { paused=true; activeIdx=(activeIdx-1+FILTERED.length)%FILTERED.length; snapTo(activeIdx+FILTERED.length); setTimeout(function(){paused=false;},2000); };
    nextBtn.onclick = function() { paused=true; activeIdx=(activeIdx+1)%FILTERED.length; snapTo(activeIdx+FILTERED.length); setTimeout(function(){paused=false;},2000); };

    inner.addEventListener('click', function(e) {
      if (e.target.closest('button')) return;
      var card = e.target.closest('.carousel-card-item');
      if (card) {
        paused = true;
        var idx = parseInt(card.dataset.index);
        activeIdx = idx;
        snapTo(idx + FILTERED.length);
        setTimeout(function(){ paused=false; }, 2000);
      }
    });

    track.addEventListener('mouseenter', function(){ paused=true; });
    track.addEventListener('mouseleave', function(){ paused=false; });

    // Category filter
    document.querySelectorAll('.carousel-cat-btn').forEach(function(btn) {
      btn.onclick = function() {
        CURRCAT = btn.dataset.cat;
        document.querySelectorAll('.carousel-cat-btn').forEach(function(b) {
          b.classList.toggle('bg-charcoal-800', b.dataset.cat===CURRCAT);
          b.classList.toggle('text-white', b.dataset.cat===CURRCAT);
          b.classList.toggle('border-charcoal-300', b.dataset.cat!==CURRCAT);
          b.classList.toggle('text-charcoal-500', b.dataset.cat!==CURRCAT);
        });
        paused = true;
        FILTERED = ALLPRODS.filter(function(p){ return CURRCAT==='all'||p.category===CURRCAT; });
        scrollX = 0; activeIdx = 0;
        rebuildInner();
        snapTo(FILTERED.length);
        setTimeout(function(){ paused=false; }, 300);
      };
    });

    // Add to cart
    document.addEventListener('click', function(e) {
      var add = e.target.closest('.carousel-add-cart');
      if (!add) return;
      e.stopPropagation(); e.preventDefault();
      var pid = add.dataset.product, name = add.dataset.name, price = parseFloat(add.dataset.price)||10;
      var cart = JSON.parse(localStorage.getItem('ps-cart')||'[]');
      var exist = cart.find(function(i){ return i.id===pid; });
      if (exist) exist.quantity++; else cart.push({id:pid, name:name, price:price, color:'', size:'', quantity:1});
      localStorage.setItem('ps-cart', JSON.stringify(cart));
      add.textContent = '✓ Added'; setTimeout(function(){ add.textContent = '加入购物车'; }, 1000);
    }, true);

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
