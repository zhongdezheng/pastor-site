---
import products from '../content/products.json';

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;

const labels = {
  en: { sizes:'Sizes', weight:'Weight', stock:'In Stock', outOfStock:'Out of Stock', addToCart:'Add to Cart', all:'All', clothing:'Clothing', jewelry:'Jewelry' },
  zh: { sizes:'尺码', weight:'克重', stock:'库存', outOfStock:'已售罄', addToCart:'加入购物车', all:'全部', clothing:'服装', jewelry:'首饰' },
};
const t = labels[lang];
---

<section id="products" class="py-24 lg:py-32 px-4 sm:px-6 bg-white">
  <div class="max-w-5xl mx-auto">

    <!-- Category filter pills -->
    <div class="flex gap-3 mb-8">
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors bg-charcoal-800 text-white" data-cat="all">{t.all}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="apparel">{t.clothing}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="accessories">{t.jewelry}</button>
    </div>

    <!-- Product grid — same style as ProductShowcase -->
    <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {products.map(p => (
        <a href={`/${lang}/products/${p.id}/`} class="product-card-item block bg-white rounded-xl border border-beige-200 overflow-hidden cursor-pointer hover:shadow-2xl transition-all duration-500 hover:-translate-y-4 hover:scale-[1.02]" data-category={p.category} data-id={p.id}>
          <div class="aspect-square bg-beige-100 flex items-center justify-center relative">
            {p.images && p.images[0] ? (
              <img src={p.images[0]} alt="" class="w-full h-full object-cover" loading="lazy" />
            ) : (
              <span class="text-3xl">👕</span>
            )}
            {p.stock === 0 && <div class="absolute inset-0 bg-black/20 flex items-center justify-center"><span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded">{t.outOfStock}</span></div>}
          </div>
          <div class="p-4 flex flex-col gap-2" style="min-height:240px">
            <h3 class="font-serif font-bold text-xs text-charcoal-800 leading-tight line-clamp-2 flex-shrink-0">{p.name[lang]}</h3>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="font-bold text-sm text-charcoal-700">${p.price}</span>
              <div class="flex items-center gap-1">
                <button class="carousel-qty-btn w-6 h-6 sm:w-5 sm:h-5 border border-charcoal-300 rounded-full flex items-center justify-center text-xs sm:text-[10px] text-charcoal-500 hover:bg-charcoal-100 leading-none" data-id={p.id} data-action="minus">−</button>
                <span class="carousel-qty-val text-xs text-charcoal-700 font-medium min-w-[16px] text-center" data-id={p.id}>1</span>
                <button class="carousel-qty-btn w-6 h-6 sm:w-5 sm:h-5 border border-charcoal-300 rounded-full flex items-center justify-center text-xs sm:text-[10px] text-charcoal-500 hover:bg-charcoal-100 leading-none" data-id={p.id} data-action="plus">+</button>
              </div>
            </div>
            <div class="flex flex-wrap gap-1 flex-shrink-0" data-id={p.id} style="min-height:20px">
              {p.sizes.map((s, i) => <span class="carousel-sz-opt text-[9px] border rounded px-1 py-0 whitespace-nowrap cursor-pointer transition-colors" style=`border-color:${i===0?'#333':'#d1d5db'};color:${i===0?'#1f2937':'#6b7280'}` data-id={p.id} data-size={s}>{s}</span>)}
            </div>
            <div class="flex items-center gap-1.5 flex-wrap" data-id={p.id}>
              <div class="flex gap-1.5">
              {p.colors.map((c, i) => {
                const colorMap = { '白色': '#f0f0f0', '黑色': '#222', '灰色': '#999', '深蓝': '#1e3a5f', '米白': '#f5f0e8', '粉色': '#ffb6c1', '杏色': '#f5deb3' };
                const bg = colorMap[c] || c;
                return <span class="carousel-color-dot inline-block w-5 h-5 sm:w-4 sm:h-4 rounded-full cursor-pointer border-2 transition-colors" style={`background:${bg};border-color:${i===0?'#333':'#d1d5db'}`} data-id={p.id} data-color={c} title={c}></span>;
              })}
              </div>
            <button class="carousel-add-cart-btn py-1 px-3 ml-auto bg-charcoal-800 hover:bg-charcoal-700 text-white rounded-lg text-[10px] font-medium transition-colors flex-shrink-0" data-id={p.id}>{t.addToCart}</button>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script type="application/json" id="__carouselLabels" set:html={JSON.stringify(labels[lang])}></script>
<script type="application/json" id="__carouselProducts" set:html={JSON.stringify(products)}></script>
<script is:inline>
  (function() {
    var LABELS = JSON.parse(document.getElementById('__carouselLabels').textContent);
    var PRODUCTS = JSON.parse(document.getElementById('__carouselProducts').textContent);
    var WHATSAPP = '8613602812927';
    var activeCat = 'all';

    // Load cart from localStorage
    var cartItems = [];
    try { var s = localStorage.getItem('ps-cart'); if (s) cartItems = JSON.parse(s); } catch(e) {}

    document.querySelectorAll('.carousel-cat-btn').forEach(function(b){
      if (b.dataset.cat === 'all') b.textContent = LABELS.all;
      if (b.dataset.cat === 'apparel') b.textContent = LABELS.clothing;
      if (b.dataset.cat === 'accessories') b.textContent = LABELS.jewelry;
    });

    document.querySelectorAll('.carousel-cat-btn').forEach(function(btn) {
      btn.onclick = function() {
        activeCat = btn.dataset.cat;
        document.querySelectorAll('.carousel-cat-btn').forEach(function(b) {
          b.classList.toggle('bg-charcoal-800', b.dataset.cat === activeCat);
          b.classList.toggle('text-white', b.dataset.cat === activeCat);
        });
        document.querySelectorAll('#product-grid > .product-card-item').forEach(function(card) {
          card.style.display = (activeCat === 'all' || card.dataset.category === activeCat) ? '' : 'none';
        });
      };
    });

    function saveCart() { localStorage.setItem('ps-cart', JSON.stringify(cartItems)); }

    // Quantity buttons
    document.querySelectorAll('.carousel-qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var id = btn.dataset.id;
        var action = btn.dataset.action;
        var valEl = document.querySelector('.carousel-qty-val[data-id="' + id + '"]');
        if (!valEl) return;
        var val = parseInt(valEl.textContent) || 1;
        if (action === 'plus') val++;
        else if (action === 'minus') val = Math.max(1, val - 1);
        valEl.textContent = val;
      });
    });

    // Color selection
    document.querySelectorAll('.carousel-color-dot').forEach(function(dot) {
      dot.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var pid = dot.dataset.id;
        var color = dot.dataset.color;
        document.querySelectorAll('.carousel-color-dot[data-id="' + pid + '"]').forEach(function(d) {
          d.style.borderColor = d.dataset.color === color ? '#333' : '#d1d5db';
        });
      });
    });

    // Size selection
    document.querySelectorAll('.carousel-sz-opt').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var pid = el.dataset.id;
        var size = el.dataset.size;
        document.querySelectorAll('.carousel-sz-opt[data-id="' + pid + '"]').forEach(function(s) {
          s.style.borderColor = s.dataset.size === size ? '#333' : '#d1d5db';
          s.style.color = s.dataset.size === size ? '#1f2937' : '#6b7280';
        });
      });
    });

    // Add to Cart button
    document.querySelectorAll('.carousel-add-cart-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        var id = btn.dataset.id;
        var prod = PRODUCTS.find(function(p) { return p.id === id; });
        if (!prod) return;
        // Get selected color
        var colorDots = document.querySelectorAll('.carousel-color-dot[data-id="' + id + '"]');
        var selColor = '';
        colorDots.forEach(function(d) { if (d.style.borderColor === 'rgb(51, 51, 51)' || d.style.borderColor === '#333') selColor = d.dataset.color; });
        if (!selColor) selColor = prod.colors[0];
        // Get selected size
        var szOpts = document.querySelectorAll('.carousel-sz-opt[data-id="' + id + '"]');
        var selSize = '';
        szOpts.forEach(function(s) { if (s.style.borderColor === 'rgb(51, 51, 51)' || s.style.borderColor === '#333') selSize = s.dataset.size; });
        if (!selSize) selSize = prod.sizes[0];
        // Get qty
        var qtyEl = document.querySelector('.carousel-qty-val[data-id="' + id + '"]');
        var qty = qtyEl ? parseInt(qtyEl.textContent) || 1 : 1;
        // Add to cart
        var existing = cartItems.find(function(i) { return i.id === id && i.size === selSize && i.color === selColor; });
        if (existing) existing.quantity += qty;
        else cartItems.push({ id: id, name: prod.name, price: prod.price, size: selSize, color: selColor, quantity: qty });
        saveCart();
        // Flash feedback
        btn.textContent = '✓ ' + LABELS.addToCart;
        btn.classList.add('bg-green-600');
        setTimeout(function() { btn.textContent = LABELS.addToCart; btn.classList.remove('bg-green-600'); }, 1200);
      });
    });
  })();
</script>
