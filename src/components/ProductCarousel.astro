---
import products from '../content/products.json';
import siteData from '../content/site.json';
const { site } = siteData;

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;

const labels = {
  en: { sizes:'Sizes', weight:'Weight', stock:'In Stock', outOfStock:'Out of Stock', addToCart:'Add to Cart', color:'Color', qty:'Qty', all:'All', clothing:'Clothing', jewelry:'Jewelry' },
  zh: { sizes:'尺码', weight:'克重', stock:'库存', outOfStock:'已售罄', addToCart:'加入购物车', color:'颜色', qty:'数量', all:'全部', clothing:'服装', jewelry:'首饰' },
};
const t = labels[lang];

const appProducts = products.filter(p => p.category === 'apparel');
const jewelryProducts = products.filter(p => p.category !== 'apparel');
---

<section id="products" class="py-24 lg:py-32 px-4 sm:px-6 bg-white overflow-hidden">
  <div class="max-w-5xl mx-auto">

    <!-- Category filter buttons -->
    <div class="flex gap-3 mb-8">
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors bg-charcoal-800 text-white" data-cat="all">{t.all}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="apparel">{t.clothing}</button>
      <button class="carousel-cat-btn px-5 py-2 rounded-full text-sm font-medium transition-colors border border-charcoal-300 text-charcoal-500 hover:border-charcoal-500" data-cat="accessories">{t.jewelry}</button>
    </div>

    <!-- Product Carousel -->
    <div id="product-carousel" class="product-carousel relative select-none" style="height: 340px;">
      <div id="product-track" class="product-track flex items-start justify-center h-full transition-transform duration-600 ease-out">
        {appProducts.map((p, i) => (
          <div class="carousel-card shrink-0 bg-white rounded-2xl border border-beige-200 shadow-sm transition-all duration-500 ease-out flex flex-col" data-index={i} data-category={p.category} data-id={p.id}>
            <div class="aspect-square bg-beige-100 rounded-t-2xl flex items-center justify-center text-3xl flex-shrink-0 relative overflow-hidden">
              {p.images && p.images[0] ? <img src={p.images[0]} alt="" class="w-full h-full object-cover" loading="lazy" /> : <span>👕</span>}
              {p.stock === 0 && <div class="absolute inset-0 bg-black/20 flex items-center justify-center"><span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded">{t.outOfStock}</span></div>}
            </div>
            <div class="p-3 flex flex-col flex-1">
              <h3 class="font-serif font-bold text-xs text-charcoal-800 mb-0.5 leading-tight">{p.name[lang]}</h3>
              <p class="text-charcoal-700 font-semibold text-sm mb-0.5">${p.price}</p>
              <p class="text-[10px] text-charcoal-400 mb-2">{t.weight}: {p.weight}</p>
              <div class="carousel-colors flex gap-0.5 mb-1">
                {p.colors.map(c => {
                  const bg = c==='白色'?'#f0f0f0':c==='黑色'?'#222':c==='灰色'?'#999':c==='深蓝'?'#1e3a5f':c;
                  return <span class="inline-block w-3 h-3 rounded-full border border-charcoal-300" style={`background:${bg}`} title={c}></span>;
                })}
              </div>
              <div class="carousel-sizes flex flex-wrap gap-0.5 mb-2">
                {p.sizes.map(s => <button class="carousel-size-btn px-1.5 py-0 text-[9px] border border-charcoal-300 rounded hover:border-charcoal-600 transition-colors" data-product={p.id} data-size={s}>{s}</button>)}
              </div>
              <div class="carousel-qty flex items-center gap-1 mb-2 hidden">
                <button class="carousel-qty-minus w-5 h-5 border border-charcoal-300 rounded text-[10px] flex items-center justify-center">−</button>
                <span class="carousel-qty-val w-4 text-center text-xs font-bold">1</span>
                <button class="carousel-qty-plus w-5 h-5 border border-charcoal-300 rounded text-[10px] flex items-center justify-center">+</button>
              </div>
              <div class="mt-auto flex items-center justify-between">
                <span class={`text-[10px] font-medium ${p.stock > 0 ? 'text-green-600' : 'text-red-400'}`}>
                  {p.stock > 0 ? `${t.stock}: ${p.stock}` : t.outOfStock}
                </span>
                <button class="carousel-add-cart px-2 py-1.5 bg-charcoal-800 text-white text-[10px] rounded-lg hover:bg-charcoal-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap" data-product={p.id} data-name={p.name[lang]} data-price={p.price} disabled={p.stock===0}>{t.addToCart}</button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="absolute inset-y-0 left-0 w-12 md:w-24 pointer-events-none bg-gradient-to-r from-white/95 to-transparent z-10 rounded-l-2xl"></div>
      <div class="absolute inset-y-0 right-0 w-12 md:w-24 pointer-events-none bg-gradient-to-l from-white/95 to-transparent z-10 rounded-r-2xl"></div>

      <button id="prod-prev" class="absolute left-1 md:left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20">‹</button>
      <button id="prod-next" class="absolute right-1 md:right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20">›</button>
    </div>

    <div class="flex justify-center gap-2 mt-6">
      {appProducts.map((_, i) => <span class={`carousel-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-400 ${i===0?'bg-charcoal-700 scale-125':'bg-charcoal-300 hover:bg-charcoal-400'}`} data-pdot={i}></span>)}
    </div>
  </div>
</section>

<style>
  .carousel-card { width: 160px; min-height: 300px; }
  @media (min-width: 768px) { .carousel-card { width: 180px; } }
  .carousel-card[data-offset="-3"], .carousel-card[data-offset="3"] { opacity:0; transform:scale(0.72); pointer-events:none; }
  .carousel-card[data-offset="-2"], .carousel-card[data-offset="2"] { opacity:0.3; transform:scale(0.80); filter:blur(1px); pointer-events:none; }
  .carousel-card[data-offset="-1"], .carousel-card[data-offset="1"] { opacity:0.6; transform:scale(0.88); cursor:pointer; }
  .carousel-card[data-offset="0"] { opacity:1; transform:scale(1); box-shadow:0 16px 48px rgba(120,100,80,0.12),0 6px 16px rgba(120,100,80,0.06); z-index:5; min-height:340px; }
  .carousel-card[data-offset="0"] .carousel-qty { display:flex!important; }
  .carousel-card[data-offset="0"] .carousel-colors span { width:16px!important; height:16px!important; }
  .carousel-card[data-offset="0"] .carousel-size-btn { padding: 0.15rem 0.5rem!important; font-size:10px!important; }
  .carousel-card:hover[data-offset="-1"],.carousel-card:hover[data-offset="1"] { opacity:0.9; transform:scale(0.92); }
  #product-track { gap: 10px; }
  @media (min-width: 768px) { #product-track { gap: 14px; } }
</style>

<script type="application/json" id="__carouselData" set:html={JSON.stringify(products.map(p=>({id:p.id,name:p.name[lang],price:p.price,colors:p.colors,sizes:p.sizes,category:p.category,stock:p.stock,image:p.images?p.images[0]:''})))}></script>
<script is:inline>
  var ALLPRODS = JSON.parse(document.getElementById("__carouselData").textContent);
  var CURRCAT = 'all';
  var FILTERED = ALLPRODS.filter(function(p){ return CURRCAT==='all'||p.category===CURRCAT; });

  function refilter() {
    FILTERED = ALLPRODS.filter(function(p){ return CURRCAT==='all'||p.category===CURRCAT; });
    // Rebuild track
    var track = document.getElementById('product-track');
    track.innerHTML = FILTERED.map(function(p,i){
      var colorsHtml = p.colors.map(function(c){
        var bg = c==='白色'?'#f0f0f0':c==='黑色'?'#222':c==='灰色'?'#999':c==='深蓝'?'#1e3a5f':c;
        return '<span class="inline-block w-3 h-3 rounded-full border border-charcoal-300" style="background:'+bg+'" title="'+c+'"></span>';
      }).join('');
      var sizesHtml = p.sizes.map(function(s){ return '<button class="carousel-size-btn px-1.5 py-0 text-[9px] border border-charcoal-300 rounded hover:border-charcoal-600 transition-colors" data-product="'+p.id+'" data-size="'+s+'">'+s+'</button>'; }).join('');
      return '<div class="carousel-card shrink-0 bg-white rounded-2xl border border-beige-200 shadow-sm transition-all duration-500 ease-out flex flex-col" data-index="'+i+'" data-category="'+p.category+'" data-id="'+p.id+'">'
        +'<div class="aspect-square bg-beige-100 rounded-t-2xl flex items-center justify-center text-3xl flex-shrink-0 relative overflow-hidden">'+(p.image?('<img src="'+p.image+'" alt="" class="w-full h-full object-cover" loading="lazy" />'):'<span>👕</span>')+(p.stock===0?'<div class="absolute inset-0 bg-black/20 flex items-center justify-center"><span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded">售罄</span></div>':'')+'</div>'
        +'<div class="p-3 flex flex-col flex-1"><h3 class="font-serif font-bold text-xs text-charcoal-800 mb-0.5 leading-tight">'+p.name+'</h3><p class="text-charcoal-700 font-semibold text-sm mb-0.5">$'+p.price+'</p>'
        +'<div class="carousel-colors flex gap-0.5 mb-1">'+colorsHtml+'</div>'
        +'<div class="carousel-sizes flex flex-wrap gap-0.5 mb-2">'+sizesHtml+'</div>'
        +'<div class="carousel-qty flex items-center gap-1 mb-2 hidden"><button class="carousel-qty-minus w-5 h-5 border border-charcoal-300 rounded text-[10px] flex items-center justify-center">−</button><span class="carousel-qty-val w-4 text-center text-xs font-bold">1</span><button class="carousel-qty-plus w-5 h-5 border border-charcoal-300 rounded text-[10px] flex items-center justify-center">+</button></div>'
        +'<div class="mt-auto flex items-center justify-between"><span class="text-[10px] font-medium '+(p.stock>0?'text-green-600':'text-red-400')+'">库存:'+p.stock+'</span><button class="carousel-add-cart px-2 py-1.5 bg-charcoal-800 text-white text-[10px] rounded-lg hover:bg-charcoal-700 transition-colors" data-product="'+p.id+'">加入购物车</button></div></div></div>';
    }).join('');
    // Rebuild dots
    var dots = document.querySelectorAll('.carousel-dot').length ? document.querySelector('.flex.justify-center.gap-2.mt-6') : document.querySelector('#product-carousel'); 
  }

  document.addEventListener('DOMContentLoaded', function(){
    var track = document.getElementById('product-track');
    var cards = function(){ return document.querySelectorAll('.carousel-card'); };
    var dotContainer = document.querySelector('#product-carousel').nextElementSibling;
    var prevBtn = document.getElementById('prod-prev');
    var nextBtn = document.getElementById('prod-next');
    if (!track) return;
    var targetCard = 0;
    var scrollPos = 0;
    var paused = false;
    var lastTime = 0;
    var animFrame = null;
    var SCROLL_SPEED = 20;

    function getCardW(){ return window.innerWidth>=768?180:160; }
    function getGap(){ return window.innerWidth>=768?14:10; }
    function getUnit(){ return getCardW()+getGap(); }

    function renderSmooth(floatIdx){
      var cw = getCardW(), gap = getGap(), unit = cw+gap;
      var total = cards().length;
      cards().forEach(function(card,i){
        var dist = i - floatIdx;
        if(dist<-total/2) dist+=total; if(dist>total/2) dist-=total;
        var rounded = Math.round(dist);
        card.setAttribute('data-offset', String(Math.max(-3,Math.min(3,rounded))));
        card.style.display = Math.abs(rounded)<=2?'':'none';
      });
      var containerW = track.parentElement.clientWidth;
      var offsetPx = floatIdx * unit;
      track.style.transform = 'translateX('+(containerW/2 - cw/2 - offsetPx)+'px)';
      // Update dots
      var dots = dotContainer.querySelectorAll('.carousel-dot');
      dots.forEach(function(d,i){ d.classList.toggle('bg-charcoal-700', i===Math.round(floatIdx)%total); d.classList.toggle('scale-125', i===Math.round(floatIdx)%total); });
    }

    function animate(ts){
      if(paused){ animFrame=null; return; }
      if(!lastTime) lastTime=ts;
      var dt = Math.min(ts-lastTime, 100); lastTime=ts;
      scrollPos += SCROLL_SPEED*(dt/1000);
      var total = FILTERED.length;
      var unit = getUnit();
      var totalW = total*unit;
      while(scrollPos>=totalW) scrollPos-=totalW;
      var floatIdx = (scrollPos/unit)%total;
      renderSmooth(floatIdx);
      targetCard = Math.round(floatIdx)%total;
      animFrame = requestAnimationFrame(animate);
    }
    function pause(){ paused=true; if(animFrame){ cancelAnimationFrame(animFrame); animFrame=null; } }
    function resume(){ if(paused){ paused=false; lastTime=0; animFrame=requestAnimationFrame(animate); } else if(!animFrame){ lastTime=0; animFrame=requestAnimationFrame(animate); } }

    function jumpTo(idx){
      var unit = getUnit(), total = FILTERED.length, totalW = total*unit;
      scrollPos = idx*unit; while(scrollPos<0) scrollPos+=totalW; while(scrollPos>=totalW) scrollPos-=totalW;
      renderSmooth(idx); targetCard = idx;
    }
    function go(dir){ pause(); jumpTo((targetCard+dir+FILTERED.length)%FILTERED.length); setTimeout(resume,1800); }

    prevBtn.onclick = function(){ go(-1); };
    nextBtn.onclick = function(){ go(1); };

    dotContainer.onclick = function(e){
      var dot = e.target.closest('.carousel-dot');
      if(dot){ pause(); jumpTo(parseInt(dot.getAttribute('data-pdot'))||0); setTimeout(resume,1800); }
    };

    // Click non-center card to jump
    track.addEventListener('click', function(e){
      if(e.target.closest('button')) return;
      var card = e.target.closest('.carousel-card');
      if(card && card.getAttribute('data-offset')!=='0'){ pause(); jumpTo(parseInt(card.getAttribute('data-index'))||0); setTimeout(resume,1800); }
    });

    track.addEventListener('mouseenter', pause);
    track.addEventListener('mouseleave', resume);

    // Touch
    var tX=0;
    track.addEventListener('touchstart', function(e){ tX=e.changedTouches[0].screenX; pause(); }, {passive:true});
    track.addEventListener('touchend', function(e){ var d=tX-e.changedTouches[0].screenX; if(Math.abs(d)>40) go(d>0?1:-1); else resume(); }, {passive:true});

    window.addEventListener('resize', function(){ renderSmooth(targetCard); });

    // Category filter buttons
    document.querySelectorAll('.carousel-cat-btn').forEach(function(btn){
      btn.onclick = function(){
        CURRCAT = btn.getAttribute('data-cat');
        document.querySelectorAll('.carousel-cat-btn').forEach(function(b){
          b.classList.toggle('bg-charcoal-800', b.getAttribute('data-cat')===CURRCAT);
          b.classList.toggle('text-white', b.getAttribute('data-cat')===CURRCAT);
          b.classList.toggle('border-charcoal-300', b.getAttribute('data-cat')!==CURRCAT);
          b.classList.toggle('text-charcoal-500', b.getAttribute('data-cat')!==CURRCAT);
        });
        refilter();
        pause();
        targetCard=0; scrollPos=0;
        jumpTo(0);
        // Rebind dots
        dotContainer.innerHTML = FILTERED.map(function(_,i){ return '<span class="carousel-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-400 '+(i===0?'bg-charcoal-700 scale-125':'bg-charcoal-300 hover:bg-charcoal-400')+'" data-pdot="'+i+'"></span>'; }).join('');
        setTimeout(resume,200);
      };
    });

    // Size selection
    document.addEventListener('click', function(e){
      var sz = e.target.closest('.carousel-size-btn');
      if(sz){
        var pid = sz.getAttribute('data-product');
        var size = sz.getAttribute('data-size');
        document.querySelectorAll('.carousel-size-btn[data-product="'+pid+'"]').forEach(function(b){ b.classList.remove('border-charcoal-600','bg-charcoal-100'); b.classList.add('border-charcoal-300'); });
        sz.classList.add('border-charcoal-600','bg-charcoal-100');
        sz.classList.remove('border-charcoal-300');
        return;
      }
      // Qty buttons
      var q = e.target.closest('.carousel-qty-minus, .carousel-qty-plus');
      if(q){
        var val = q.parentElement.querySelector('.carousel-qty-val');
        var v = parseInt(val.textContent)||1;
        if(q.classList.contains('carousel-qty-minus')) v = Math.max(1, v-1);
        else v++;
        val.textContent = v;
        return;
      }
      // Add to cart
      var add = e.target.closest('.carousel-add-cart');
      if(add){
        var pid2 = add.getAttribute('data-product');
        var name2 = add.getAttribute('data-name')||add.closest('.carousel-card').querySelector('h3').textContent;
        var price2 = parseFloat(add.getAttribute('data-price'))||10;
        var sizeBtn = document.querySelector('.carousel-size-btn[data-product="'+pid2+'"].border-charcoal-600');
        var size2 = sizeBtn ? sizeBtn.getAttribute('data-size') : '';
        var qtyEl = add.closest('.carousel-card').querySelector('.carousel-qty-val');
        var qty2 = qtyEl ? parseInt(qtyEl.textContent)||1 : 1;
        var cart = JSON.parse(localStorage.getItem('ps-cart')||'[]');
        var exist = cart.find(function(i){ return i.id===pid2 && i.size===size2; });
        if(exist) exist.quantity += qty2; else cart.push({id:pid2,name:name2,price:price2,color:'',size:size2,quantity:qty2});
        localStorage.setItem('ps-cart',JSON.stringify(cart));
        // Flash
        add.textContent = '✓ Added'; setTimeout(function(){ add.textContent = '加入购物车'; },1000);
      }
    });

    scrollPos=0; targetCard=0; renderSmooth(0); resume();
  });
</script>
