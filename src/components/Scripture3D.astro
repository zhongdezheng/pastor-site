---
/*
 * ============================================================================
 * 文件位置: src/components/Scripture3D.astro
 * 作用: 经文轮播组件—横向连续滚动，所有经文全部可见
 * 被谁调用: src/pages/index.astro（首页）
 * 修改指南:
 *   - 【修改】经文内容: 编辑 src/content/scriptures.json
 *   - 【修改】滚动速度: 编辑 JS 中 SCROLL_SPEED（当前 40，越大越快）
 *   - 【修改】卡片宽高: 改下方 <style is:global> 中的 width/height
 *   - 注意: 改卡片尺寸时，CSS width、JS getCW()、容器 style="height" 三者必须一致
 * ============================================================================
 */

import scriptures from '../content/scriptures.json';

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
---

<section id="scriptures" class="py-24 lg:py-32 px-4 sm:px-6 bg-gradient-to-b from-white to-beige-100 overflow-hidden">
  <div class="max-w-5xl mx-auto">

    <!-- 容器 -->
    <div id="scripture-carousel" class="scripture-carousel relative select-none" style="height: 380px;">

      <!-- 经文数据注入 -->
      <script type="application/json" id="__scriptureData" set:html={JSON.stringify(scriptures.map(s => ({text: s[lang], ref: lang === 'en' ? s.refEn : s.refZh})))}></script>

      <!-- 轨道：JS 动态填充 -->
      <div id="scripture-track" class="scripture-track flex items-center justify-center h-full transition-transform duration-700 ease-out"></div>

      <!-- 左右渐变遮罩 -->
      <div class="absolute inset-y-0 left-0 w-16 md:w-28 pointer-events-none bg-gradient-to-r from-white/90 to-transparent z-10"></div>
      <div class="absolute inset-y-0 right-0 w-16 md:w-28 pointer-events-none bg-gradient-to-l from-white/90 to-transparent z-10"></div>

      <!-- 箭头 -->
      <button id="scr-prev" class="scr-btn scr-prev absolute left-1 md:left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg hover:border-charcoal-300 transition-all z-20" aria-label="Previous">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="scr-next" class="scr-btn scr-next absolute right-1 md:right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg hover:border-charcoal-300 transition-all z-20" aria-label="Next">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-8">
      {scriptures.map((_, i) => (
        <span class={`scr-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-400 ${i === 0 ? 'bg-charcoal-700 scale-125' : 'bg-charcoal-300 hover:bg-charcoal-400'}`} data-sdot={i}></span>
      ))}
    </div>
  </div>
</section>

<!-- is:global 是关键 — JS 动态生成的卡片没有 Astro scoped data-astro-cid 属性，必须用全局样式 -->
<style is:global>
  /* ── 卡片尺寸：【修改】宽高在此改，同时改下方 JS 的 getCW() 和容器 style="height" ── */
  #scripture-track .scripture-card {
    width: 280px;
    height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    #scripture-track .scripture-card {
      width: 340px;
      height: 360px;
    }
  }

  #scripture-track {
    gap: 16px;
  }
  @media (min-width: 768px) {
    #scripture-track { gap: 24px; }
  }

  .scr-dot.active {
    background-color: rgb(86 78 71);
    transform: scale(1.25);
  }

  .scr-btn { opacity: 0.9; }
  .scr-btn:hover { opacity: 1; }
</style>

<script is:inline>
  function initScriptureCarousel() {
    var dataEl = document.getElementById('__scriptureData');
    var DATA = dataEl ? JSON.parse(dataEl.textContent) : [];
    if (!DATA.length) return;
    var total = DATA.length;

    var track = document.getElementById('scripture-track');
    var dots = document.querySelectorAll('.scr-dot');
    var prevBtn = document.getElementById('scr-prev');
    var nextBtn = document.getElementById('scr-next');
    if (!track) return;

    // ★ 这里跟 CSS 宽度必须一致
    function getCW() { return window.innerWidth >= 768 ? 340 : 280; }
    function getGap() { return window.innerWidth >= 768 ? 24 : 16; }
    function getUnit() { return getCW() + getGap(); }

    function cardHTML(s) {
      return '<div class="scripture-card shrink-0 bg-white rounded-2xl shadow-lg border border-beige-200 p-8 md:p-10 transition-all duration-700 ease-out flex flex-col justify-center">' +
        '<p class="text-base md:text-xl leading-relaxed font-serif italic text-charcoal-700 mb-5 line-clamp-6">' + (s.text || '') + '</p>' +
        '<p class="text-sm text-charcoal-400 font-medium tracking-wide border-t border-beige-200 pt-4">\u2014 ' + (s.ref || '') + '</p></div>';
    }

    // 3 组实现无缝循环
    var html = '';
    for (var r = 0; r < 3; r++) {
      for (var i = 0; i < total; i++) html += cardHTML(DATA[i]);
    }
    track.innerHTML = html;

    var SCROLL_SPEED = 40;
    var animFrame = null, paused = false, translateX = 0, lastTime = 0, activeIndex = 0;
    var totalWidth = total * getUnit();

    function animate(ts) {
      if (paused) { animFrame = null; return; }
      if (!lastTime) lastTime = ts;
      var dt = Math.min(ts - lastTime, 100);
      lastTime = ts;
      translateX -= SCROLL_SPEED * (dt / 1000);
      while (translateX <= -totalWidth) translateX += totalWidth;
      while (translateX > 0) translateX -= totalWidth;
      track.style.transform = 'translateX(' + translateX + 'px)';
      var raw = (-translateX % totalWidth + totalWidth) % totalWidth;
      var idx = Math.floor(raw / getUnit()) % total;
      if (idx !== activeIndex) {
        activeIndex = idx;
        dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
      }
      animFrame = requestAnimationFrame(animate);
    }

    function pauseAuto() { paused = true; if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; } }
    function resumeAuto() { paused = false; lastTime = 0; animFrame = requestAnimationFrame(animate); }

    if (prevBtn) prevBtn.addEventListener('click', shift.bind(null, -1));
    if (nextBtn) nextBtn.addEventListener('click', shift.bind(null, 1));

    function shift(dir) {
      paused = true;
      translateX -= dir * getUnit();
      while (translateX <= -totalWidth) translateX += totalWidth;
      while (translateX > 0) translateX -= totalWidth;
      activeIndex = Math.floor(((-translateX % totalWidth + totalWidth) % totalWidth) / getUnit()) % total;
      dots.forEach(function(d, i) { d.classList.toggle('active', i === activeIndex); });
      track.style.transform = 'translateX(' + translateX + 'px)';
      setTimeout(resumeAuto, 3000);
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        paused = true;
        translateX = -(totalWidth + i * getUnit());
        activeIndex = i;
        dots.forEach(function(d, j) { d.classList.toggle('active', j === i); });
        track.style.transform = 'translateX(' + translateX + 'px)';
        setTimeout(resumeAuto, 3000);
      });
    });

    track.addEventListener('mouseenter', pauseAuto);
    track.addEventListener('mouseleave', resumeAuto);

    var tx0 = 0, txStart = 0;
    track.addEventListener('touchstart', function(e) { tx0 = e.changedTouches[0].screenX; txStart = translateX; pauseAuto(); }, { passive: true });
    track.addEventListener('touchmove', function(e) { var dx = e.changedTouches[0].screenX - tx0; translateX = txStart + dx; while (translateX <= -totalWidth) translateX += totalWidth; while (translateX > 0) translateX -= totalWidth; track.style.transform = 'translateX(' + translateX + 'px)'; }, { passive: true });
    track.addEventListener('touchend', function() { setTimeout(resumeAuto, 2000); });

    document.addEventListener('keydown', function(e) { if (e.key === 'ArrowLeft') shift(-1); if (e.key === 'ArrowRight') shift(1); });

    translateX = -totalWidth;
    track.style.transform = 'translateX(-' + totalWidth + 'px)';
    resumeAuto();
  }

  initScriptureCarousel();
  document.addEventListener('astro:page-load', initScriptureCarousel);
</script>
