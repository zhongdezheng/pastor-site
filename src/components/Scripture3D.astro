---
import scriptures from '../content/scriptures.json';
interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
const labels = {
  en: { title: 'Words of Life', subtitle: 'Scriptures that sustain us through every season' },
  zh: { title: '生命的话语', subtitle: '陪伴我们走过每个季节的经文' },
};
const t = labels[lang];
---

<section id="scriptures" class="py-24 lg:py-32 px-4 sm:px-6 bg-gradient-to-b from-white to-cream-100 overflow-hidden">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title text-clay-900">{t.title}</h2>
    <p class="section-subtitle">{t.subtitle}</p>

    <!-- Carousel Container -->
    <div id="scripture-carousel" class="scripture-carousel mt-16 relative select-none" style="height: 380px;">
      <!-- Track -->
      <div id="scripture-track" class="scripture-track flex items-center justify-center h-full transition-transform duration-700 ease-out">
        {scriptures.map((s, i) => (
          <div
            class="scripture-card shrink-0 bg-white rounded-2xl shadow-lg border border-cream-200 p-8 md:p-10 transition-all duration-700 ease-out"
            data-index={i}
          >
            <p class="text-base md:text-xl leading-relaxed font-serif italic text-clay-700 mb-5 line-clamp-6">
              {s[lang]}
            </p>
            <p class="text-sm text-clay-400 font-medium tracking-wide border-t border-cream-200 pt-4">— {s.ref}</p>
          </div>
        ))}
      </div>

      <!-- Left/Right fade overlays -->
      <div class="absolute inset-y-0 left-0 w-16 md:w-28 pointer-events-none bg-gradient-to-r from-white/90 to-transparent z-10"></div>
      <div class="absolute inset-y-0 right-0 w-16 md:w-28 pointer-events-none bg-gradient-to-l from-white/90 to-transparent z-10"></div>

      <!-- Arrow buttons -->
      <button id="scr-prev" class="scr-btn scr-prev absolute left-1 md:left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-cream-300 flex items-center justify-center text-clay-500 hover:bg-white hover:text-clay-800 hover:shadow-lg hover:border-clay-300 transition-all z-20" aria-label="Previous">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="scr-next" class="scr-btn scr-next absolute right-1 md:right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-cream-300 flex items-center justify-center text-clay-500 hover:bg-white hover:text-clay-800 hover:shadow-lg hover:border-clay-300 transition-all z-20" aria-label="Next">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-8">
      {scriptures.map((_, i) => (
        <span class={`scr-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-400 ${i === 0 ? 'bg-clay-700 scale-125' : 'bg-clay-300 hover:bg-clay-400'}`} data-sdot={i}></span>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Fixed card dimensions ── */
  .scripture-card {
    width: 280px;
    height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .scripture-card {
      width: 340px;
      height: 360px;
    }
  }

  /* ── Card states by offset from center ── */
  .scripture-card[data-offset="-3"],
  .scripture-card[data-offset="3"] {
    opacity: 0;
    transform: scale(0.7);
    pointer-events: none;
  }
  .scripture-card[data-offset="-2"],
  .scripture-card[data-offset="2"] {
    opacity: 0.25;
    transform: scale(0.78);
    filter: blur(1px);
    pointer-events: none;
  }
  .scripture-card[data-offset="-1"],
  .scripture-card[data-offset="1"] {
    opacity: 0.55;
    transform: scale(0.86);
    cursor: pointer;
  }
  .scripture-card[data-offset="0"] {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 20px 50px rgba(120,100,80,0.12), 0 8px 20px rgba(120,100,80,0.06);
    z-index: 5;
  }

  /* ── Gap between cards ── */
  #scripture-track {
    gap: 16px;
  }
  @media (min-width: 768px) {
    #scripture-track { gap: 24px; }
  }

  /* ── Dot active state ── */
  .scr-dot.active {
    @apply bg-clay-700 scale-125;
  }

  /* ── Button hide on small screens when not needed ── */
  .scr-btn {
    opacity: 0.9;
  }
  .scr-btn:hover {
    opacity: 1;
  }
</style>

<script>
  function initScriptureCarousel() {
    const track = document.getElementById('scripture-track');
    const cards = document.querySelectorAll<HTMLElement>('.scripture-card');
    const dots = document.querySelectorAll<HTMLElement>('.scr-dot');
    const prevBtn = document.getElementById('scr-prev');
    const nextBtn = document.getElementById('scr-next');

    if (!track || cards.length === 0) return;

    const total = cards.length;

    // ── Calculate card width for centering ──
    function getCardWidth(): number {
      const w = window.innerWidth;
      return w >= 768 ? 340 : 280;
    }
    function getGap(): number {
      return window.innerWidth >= 768 ? 24 : 16;
    }



    // ── Continuous auto-scroll animation ──
    let animFrame: number | null = null;
    let scrollPos = 0;               // current scroll offset in px (fractional, for smooth animation)
    let targetCard = 0;             // which card index is closest to center
    let paused = false;
    let lastTime = 0;
    const SCROLL_SPEED = 30;        // px per second

    function getCardUnit(): number {
      return getCardWidth() + getGap();
    }

    function animate(timestamp: number) {
      if (paused) {
        animFrame = null;
        return;
      }

      if (!lastTime) lastTime = timestamp;
      const dt = Math.min(timestamp - lastTime, 100); // cap to avoid jump after tab switch
      lastTime = timestamp;

      // Advance scroll position (right-to-left flow: cards move left, so offset decreases)
      scrollPos += SCROLL_SPEED * (dt / 1000);

      const unit = getCardUnit();
      const totalWidth = total * unit;

      // Wrap around
      while (scrollPos >= totalWidth) scrollPos -= totalWidth;

      // Determine which card is closest to center
      // scrollPos / unit = floating-point card index offset
      const floatIdx = (scrollPos / unit) % total;
      targetCard = Math.round(floatIdx) % total;

      // Render with fractional offset for smooth sub-pixel positioning
      renderSmooth(floatIdx);

      animFrame = requestAnimationFrame(animate);
    }

    function renderSmooth(floatIdx: number) {
      const cw = getCardWidth();
      const gap = getGap();
      const unit = cw + gap;

      // Set data-offset for each card based on distance from floatIdx
      cards.forEach((card, i) => {
        let dist = i - floatIdx;
        // Wrap around for circular
        if (dist < -total / 2) dist += total;
        if (dist > total / 2) dist -= total;
        const rounded = Math.round(dist);
        card.setAttribute('data-offset', String(Math.max(-3, Math.min(3, rounded))));
        if (Math.abs(rounded) <= 2) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // Smooth translateX: center the floatIdx position
      const containerCenter = track.parentElement!.clientWidth / 2;
      const offsetPx = floatIdx * unit;
      const translateX = containerCenter - (cw / 2) - offsetPx;
      track.style.transform = `translateX(${translateX}px)`;

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === targetCard);
      });
    }

    // ── Pause/resume ──
    function pauseAuto() { paused = true; if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; } }
    function resumeAuto() {
      if (paused) { paused = false; lastTime = 0; animFrame = requestAnimationFrame(animate); }
      else if (!animFrame) { lastTime = 0; animFrame = requestAnimationFrame(animate); }
    }

    // Snap to a specific card index
    function jumpTo(idx: number) {
      const unit = getCardUnit();
      const totalWidth = total * unit;
      // Position so that idx is at center: scrollPos should be idx * unit (mod totalWidth)
      scrollPos = idx * unit;
      // Ensure within [0, totalWidth)
      while (scrollPos < 0) scrollPos += totalWidth;
      while (scrollPos >= totalWidth) scrollPos -= totalWidth;
      targetCard = idx;
      renderSmooth(idx);
    }

    // ── Events ──
    function go(dir: 1 | -1) {
      pauseAuto();
      const idx = (targetCard + dir + total) % total;
      jumpTo(idx);
      // Resume after a short pause so user can see the result
      setTimeout(resumeAuto, 1500);
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-sdot') || '0');
        pauseAuto();
        jumpTo(idx);
        setTimeout(resumeAuto, 1500);
      });
    });

    // Click a side card → jump to it
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-index') || '0');
        if (idx !== targetCard) {
          pauseAuto();
          jumpTo(idx);
          setTimeout(resumeAuto, 1500);
        }
      });
    });

    // Pause on hover
    track.addEventListener('mouseenter', pauseAuto);
    track.addEventListener('mouseleave', resumeAuto);

    // Touch swipe
    let touchStartX = 0;
    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      pauseAuto();
    }, { passive: true });
    track.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) {
        go(diff > 0 ? 1 : -1);
      } else {
        resumeAuto();
      }
    }, { passive: true });

    // Resize handler
    window.addEventListener('resize', () => renderSmooth(targetCard));

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });

    // Init: start at card 0 with smooth auto-scroll
    scrollPos = 0;
    targetCard = 0;
    renderSmooth(0);
    resumeAuto();
  }

  initScriptureCarousel();
  document.addEventListener('astro:page-load', initScriptureCarousel);
</script>
