---
/*
 * ============================================================================
 * 文件位置: src/components/Scripture3D.astro
 * 作用: 经文横向滚动组件，所有经文卡片从左到右连续滚动，全部可见
 * 被谁调用: src/pages/index.astro（首页）中引入
 * 修改指南:
 *   - 【修改】经文内容: 编辑 src/content/scriptures.json（每条含zh/en/refZh/refEn字段）
 *   - 【修改】滚动速度: 编辑 JS 中 SCROLL_SPEED（当前 40，像素/秒，越大越快）
 *   - 【修改】卡片尺寸: 编辑 <style> 中 .scripture-card 的 width
 *   - 【修改】区域背景: 编辑 section 的 bg-gradient-to-b from/to 颜色
 * ============================================================================
 */

import scriptures from '../content/scriptures.json';

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
---

<section id="scriptures" class="py-24 lg:py-32 px-4 sm:px-6 bg-gradient-to-b from-white to-beige-100 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="scripture-viewport relative w-full overflow-hidden" style="height: 300px;">

      <div id="scripture-track" class="scripture-track flex items-center" style="height: 100%; gap: 24px;">
        {scriptures.map((s, i) => (
          <div class="scripture-card shrink-0 bg-white rounded-2xl shadow-md border border-beige-200 p-6 flex flex-col justify-center"
               data-index={i}>
            <p class="text-base leading-relaxed font-serif italic text-charcoal-700 mb-4 line-clamp-5">
              {s[lang]}
            </p>
            <p class="text-xs text-charcoal-400 font-medium tracking-wide border-t border-beige-200 pt-4">
              — {lang === 'en' ? s.refEn : s.refZh}
            </p>
          </div>
        ))}
        <div class="shrink-0" style="width:24px;"></div>
      </div>

    </div>

    <div class="flex justify-center gap-2 mt-8">
      {scriptures.map((_, i) => (
        <span class={`scr-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-300 ${i === 0 ? 'bg-charcoal-700 scale-125' : 'bg-charcoal-300 hover:bg-charcoal-400'}`} data-sdot={i}></span>
      ))}
    </div>
  </div>
</section>

<style>
  .scripture-card {
    width: 320px;
    min-height: 240px;
    user-select: none;
  }
  @media (min-width: 768px) {
    .scripture-card {
      width: 380px;
      min-height: 260px;
    }
  }
  .scr-dot.active {
    @apply bg-charcoal-700 scale-125;
  }
</style>

<script is:inline>
  function initScriptureCarousel() {
    var track = document.getElementById('scripture-track');
    var cards = track.querySelectorAll('.scripture-card');
    var dots = document.querySelectorAll('.scr-dot');
    if (!track || cards.length === 0) return;
    var total = cards.length;

    var SCROLL_SPEED = 40;    // 【修改】滚动速度（像素/秒）
    var animFrame = null;
    var paused = false;
    var translateX = 0;       // 当前平移距离
    var lastTime = 0;
    var activeIndex = 0;

    function getCardWidth() {
      return window.innerWidth >= 768 ? 380 : 320;
    }
    function getGap() { return 24; }
    function getUnit() { return getCardWidth() + getGap(); }
    function getTotalWidth() { return total * getUnit(); }

    // 无缝循环滚动
    function animate(timestamp) {
      if (paused) { animFrame = null; return; }
      if (!lastTime) lastTime = timestamp;
      var dt = Math.min(timestamp - lastTime, 100);
      lastTime = timestamp;

      translateX -= SCROLL_SPEED * (dt / 1000);

      // 无缝循环：当第一组卡片完全滚出，重置位置
      var tw = getTotalWidth();
      while (translateX <= -tw) translateX += tw;
      while (translateX > 0) translateX -= tw;

      track.style.transform = 'translateX(' + translateX + 'px)';

      // 更新当前激活的卡片索引（用于 dot 指示器）
      var idx = Math.floor((-translateX % tw + tw) % tw / getUnit()) % total;
      if (idx !== activeIndex) {
        activeIndex = idx;
        dots.forEach(function(d, i) {
          d.classList.toggle('active', i === activeIndex);
        });
      }

      animFrame = requestAnimationFrame(animate);
    }

    // 为了无缝循环，克隆整组卡片
    function initClones() {
      // 至少需要 3 组才能保证屏幕始终被卡片填满
      var clonesNeeded = Math.max(2, Math.ceil(window.innerWidth * 2 / getTotalWidth()));
      var clones = [];
      for (var c = 0; c < clonesNeeded; c++) {
        cards.forEach(function(card, i) {
          var clone = card.cloneNode(true);
          clone.setAttribute('data-index', String(i));
          clones.push(clone);
          track.appendChild(clone);
        });
      }
    }

    function pauseAuto() {
      paused = true;
      if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
    }

    function resumeAuto() {
      paused = false;
      lastTime = 0;
      animFrame = requestAnimationFrame(animate);
    }

    // 跳转到指定卡片
    function goTo(index) {
      paused = true;
      translateX = -(index * getUnit() + getCardWidth() / 2 - window.innerWidth / 2);
      var tw = getTotalWidth();
      while (translateX <= -tw) translateX += tw;
      while (translateX > 0) translateX -= tw;
      activeIndex = index;
      track.style.transform = 'translateX(' + translateX + 'px)';
      dots.forEach(function(d, i) { d.classList.toggle('active', i === activeIndex); });
      setTimeout(function() { resumeAuto(); }, 3000);
    }

    // Dot 点击
    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() { goTo(i); });
    });

    // 鼠标悬停暂停
    track.addEventListener('mouseenter', pauseAuto);
    track.addEventListener('mouseleave', resumeAuto);

    // 触摸滑动
    var touchStartX = 0, touchStartTX = 0;
    track.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
      touchStartTX = translateX;
      pauseAuto();
    }, { passive: true });
    track.addEventListener('touchmove', function(e) {
      var dx = e.changedTouches[0].screenX - touchStartX;
      translateX = touchStartTX + dx;
      var tw = getTotalWidth();
      while (translateX <= -tw) translateX += tw;
      while (translateX > 0) translateX -= tw;
      track.style.transform = 'translateX(' + translateX + 'px)';
    }, { passive: true });
    track.addEventListener('touchend', function() {
      setTimeout(function() { resumeAuto(); }, 2000);
    });

    // 窗口大小变化时重新计算
    window.addEventListener('resize', function() {
      track.style.transform = 'translateX(' + translateX + 'px)';
    });

    // 键盘
    document.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowRight') goTo((activeIndex + 1) % total);
      if (e.key === 'ArrowLeft') goTo((activeIndex - 1 + total) % total);
    });

    // 初始化
    initClones();
    translateX = 0;
    track.style.transform = 'translateX(0px)';
    resumeAuto();
  }

  initScriptureCarousel();
  document.addEventListener('astro:page-load', initScriptureCarousel);
</script>
