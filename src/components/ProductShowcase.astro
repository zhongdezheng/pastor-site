---
import products from '../content/products.json';
import siteData from '../content/site.json';
const { site } = siteData;

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;

const labels = {
  en: {
    title: 'Faith-Inspired Apparel',
    subtitle: 'Wear your faith. Every piece designed to carry a message of hope and grace.',
    addToCart: 'Add to Cart',
    sizes: 'Sizes',
    weight: 'Weight',
    stock: 'In Stock',
    cart: 'Cart',
    empty: 'Your cart is empty',
    checkoutWA: 'Order via WhatsApp',
    sizeGuide: 'Size Guide',
    close: 'Close',
    outOfStock: 'Out of Stock',
  },
  zh: {
    title: '信仰主题服饰',
    subtitle: '穿出你的信仰。每件设计都承载着盼望与恩典的信息。',
    addToCart: '加入购物车',
    sizes: '尺码',
    weight: '重量',
    stock: '库存',
    cart: '购物车',
    empty: '购物车是空的',
    checkoutWA: '通过 WhatsApp 下单',
    sizeGuide: '尺码指南',
    close: '关闭',
    outOfStock: '已售罄',
  },
};
const t = labels[lang];

const sizeGuideData = {
  en: {
    S: 'Chest 36-38"',
    M: 'Chest 38-40"',
    L: 'Chest 40-42"',
    XL: 'Chest 42-44"',
    XXL: 'Chest 44-46"',
  },
  zh: {
    S: '胸围 91-96cm',
    M: '胸围 96-102cm',
    L: '胸围 102-107cm',
    XL: '胸围 107-112cm',
    XXL: '胸围 112-117cm',
  },
};
---

<section id="products" class="py-24 lg:py-32 px-4 sm:px-6 bg-white overflow-hidden">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title text-charcoal-900">{t.title}</h2>
    <p class="section-subtitle">{t.subtitle}</p>

    <!-- Cart toggle -->
    <div class="flex justify-end mb-8 mt-8">
      <button id="cart-toggle" class="relative px-5 py-2.5 px-5 py-2.5 bg-sage-500 hover:bg-sage-600 text-white rounded-full text-sm font-medium transition-colors transition-colors">
        &#x1F6D2; {t.cart} <span id="cart-badge" class="ml-1 bg-sage-200 text-sage-900 px-1.5 py-0.5 rounded-full text-xs hidden">0</span>
      </button>
    </div>

    <!-- Product Carousel -->
    <div id="product-carousel" class="product-carousel relative select-none" style="height: 280px;">
      <div id="product-track" class="product-track flex items-start justify-center h-full transition-transform duration-600 ease-out">
        {products.map((p, i) => (
          <div
            class="product-card shrink-0 bg-white rounded-2xl border border-beige-200 shadow-sm transition-all duration-600 ease-out flex flex-col"
            data-index={i}
          >
            <!-- Product image placeholder -->
            <div class="aspect-square bg-beige-100 rounded-t-2xl flex items-center justify-center text-3xl flex-shrink-0 relative overflow-hidden">
              {p.id.includes('hoodie') ? '🧥' : p.id.includes('cap') ? '🧢' : '👕'}
            </div>

            <div class="p-3 flex flex-col flex-1">
              <h3 class="font-serif font-bold text-xs text-charcoal-800 mb-0.5 leading-tight">{p.name[lang]}</h3>
              <p class="text-charcoal-700 font-semibold text-sm mb-0.5">${p.price}</p>
              <p class="text-[10px] text-charcoal-400 mb-2">{t.weight}: {p.weight}</p>

              <!-- Size selector -->
              <div class="mb-2">
                <label class="text-[10px] text-charcoal-400 uppercase tracking-wide">{t.sizes}</label>
                <div class="flex flex-wrap gap-0.5 mt-0.5">
                  {p.sizes.map((s) => (
                    <button
                      class="size-btn px-1.5 py-0 text-[10px] border border-charcoal-300 rounded hover:border-charcoal-500 transition-colors"
                      data-product={p.id}
                      data-size={s}
                    >{s}</button>
                  ))}
                </div>
              </div>

              <div class="mt-auto flex items-center justify-between">
                <span class={`text-[10px] font-medium ${p.stock > 0 ? 'text-green-600' : 'text-red-400'}`}>
                  {p.stock > 0 ? `${t.stock}: ${p.stock}` : t.outOfStock}
                </span>
                <button
                  class="add-to-cart px-2 py-1.5 bg-charcoal-800 text-beige-50 text-[10px] rounded-lg hover:bg-charcoal-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                  data-product={p.id}
                  data-name={p.name[lang]}
                  data-price={p.price}
                  data-image={p.images[0]}
                  disabled={p.stock === 0}
                >{t.addToCart}</button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Fade overlays -->
      <div class="absolute inset-y-0 left-0 w-12 md:w-24 pointer-events-none bg-gradient-to-r from-white/95 to-transparent z-10 rounded-l-2xl"></div>
      <div class="absolute inset-y-0 right-0 w-12 md:w-24 pointer-events-none bg-gradient-to-l from-white/95 to-transparent z-10 rounded-r-2xl"></div>

      <!-- Arrow buttons -->
      <button id="prod-prev" class="prod-btn absolute left-1 md:left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20" aria-label="Previous">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="prod-next" class="prod-btn absolute right-1 md:right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/85 backdrop-blur-sm shadow-md border border-beige-300 flex items-center justify-center text-charcoal-500 hover:bg-white hover:text-charcoal-800 hover:shadow-lg transition-all z-20" aria-label="Next">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-6">
      {products.map((_, i) => (
        <span class={`prod-dot w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-400 ${i === 0 ? 'bg-charcoal-700 scale-125' : 'bg-charcoal-300 hover:bg-charcoal-400'}`} data-pdot={i}></span>
      ))}
    </div>

    <!-- Size Guide trigger -->
    <div class="text-center mt-8">
      <button id="size-guide-trigger" class="text-sm text-charcoal-500 underline hover:text-charcoal-700 transition-colors">{t.sizeGuide}</button>
    </div>
  </div>

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="cart-overlay"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl p-6 flex flex-col">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-serif text-xl font-bold text-charcoal-800">&#x1F6D2; {t.cart}</h3>
        <button id="cart-close" class="text-charcoal-400 hover:text-charcoal-600 text-2xl">&times;</button>
      </div>
      <div id="cart-items" class="flex-1 overflow-y-auto space-y-4 mb-6">
        <p class="text-charcoal-400 text-center py-12">{t.empty}</p>
      </div>
      <div class="border-t border-beige-200 pt-4">
        <div class="flex justify-between text-charcoal-800 font-semibold mb-4">
          <span>Total</span>
          <span id="cart-total">$0</span>
        </div>
        <button id="checkout-wa" class="w-full py-3 bg-green-600 text-white rounded-xl font-medium hover:bg-green-500 transition-colors">
          {t.checkoutWA}
        </button>
      </div>
    </div>
  </div>

  <!-- Size Guide Modal -->
  <div id="size-guide-modal" class="fixed inset-0 z-50 hidden bg-black/30 backdrop-blur-sm flex items-center justify-center">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl">
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-serif text-xl font-bold text-charcoal-800">{t.sizeGuide}</h3>
        <button id="size-guide-close" class="text-charcoal-400 hover:text-charcoal-600 text-2xl">&times;</button>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-beige-200 text-charcoal-500">
            <th class="py-2 text-left">Size</th>
            <th class="py-2 text-right">{lang === 'en' ? 'Chest' : '胸围'}</th>
          </tr>
        </thead>
        <tbody>
          {Object.entries(sizeGuideData[lang]).map(([size, measure]) => (
            <tr class="border-b border-beige-100">
              <td class="py-2 font-medium text-charcoal-800">{size}</td>
              <td class="py-2 text-right text-charcoal-500">{measure}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-xs text-charcoal-400 mt-4">
        {lang === 'en' ? 'US sizes. Runs slightly larger than Asian sizing.' : '美码偏大，比亚洲尺码大一号。建议选小一码。'}
      </p>
    </div>
  </div>
</section>

<style>
  /* ── Fixed card dimensions ── */
  .product-card {
    width: 140px;
    min-height: 250px;
  }
  @media (min-width: 768px) {
    .product-card {
      width: 160px;
    }
  }

  /* ── Card states by offset from center ── */
  .product-card[data-offset="-3"],
  .product-card[data-offset="3"] {
    opacity: 0;
    transform: scale(0.72);
    pointer-events: none;
  }
  .product-card[data-offset="-2"],
  .product-card[data-offset="2"] {
    opacity: 0.3;
    transform: scale(0.80);
    filter: blur(1px);
    pointer-events: none;
  }
  .product-card[data-offset="-1"],
  .product-card[data-offset="1"] {
    opacity: 0.6;
    transform: scale(0.88);
    cursor: pointer;
  }
  .product-card[data-offset="0"] {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 16px 48px rgba(120,100,80,0.12), 0 6px 16px rgba(120,100,80,0.06);
    z-index: 5;
  }

  #product-track {
    gap: 8px;
  }
  @media (min-width: 768px) {
    #product-track { gap: 12px; }
  }

  .prod-dot.active {
    background-color: #5c4d3c;
    transform: scale(1.25);
  }
</style>

<script>
  function initProductCarousel() {
    const track = document.getElementById('product-track');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const dots = document.querySelectorAll<HTMLElement>('.prod-dot');
    const prevBtn = document.getElementById('prod-prev');
    const nextBtn = document.getElementById('prod-next');

    if (!track || cards.length === 0) return;

    let current = 0;
    const total = cards.length;

    function getCardWidth(): number {
      return window.innerWidth >= 768 ? 160 : 140;
    }
    function getGap(): number {
      return window.innerWidth >= 768 ? 12 : 8;
    }

    function render() {
      const cw = getCardWidth();
      const gap = getGap();

      cards.forEach((card, i) => {
        const offset = i - current;
        card.setAttribute('data-offset', String(offset));
        if (Math.abs(offset) <= 2) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      const containerCenter = track.parentElement!.clientWidth / 2;
      const cardCenterOffset = current * (cw + gap);
      const translateX = containerCenter - (cw / 2) - cardCenterOffset;
      track.style.transform = `translateX(${translateX}px)`;

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === current);
      });
    }

    // ── Navigation ──
    function go(dir: 1 | -1) {
      current = (current + dir + total) % total;
      render();
    }

    function goTo(idx: number) {
      current = idx;
      render();
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        goTo(parseInt(dot.getAttribute('data-pdot') || '0'));
      });
    });

    // Click side cards to jump
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        // Don't trigger when clicking buttons inside the card
        if ((e.target as HTMLElement).closest('button')) return;
        const idx = parseInt(card.getAttribute('data-index') || '0');
        if (idx !== current) goTo(idx);
      });
    });

    // Touch swipe
    let touchStartX = 0;
    let touchEndX = 0;
    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    track.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        go(diff > 0 ? 1 : -1);
      }
    }, { passive: true });

    // Keyboard
    document.addEventListener('keydown', (e) => {
      const section = document.getElementById('products');
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
      if (!isVisible) return;
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });

    // Resize
    window.addEventListener('resize', () => render());

    // Init
    render();

    // ── Cart logic (unchanged from original) ──
    const cartItems: any[] = [];
    const cartBadge = document.getElementById('cart-badge')!;
    const cartDrawer = document.getElementById('cart-drawer')!;
    const cartOverlay = document.getElementById('cart-overlay')!;
    const cartClose = document.getElementById('cart-close')!;
    const cartToggle = document.getElementById('cart-toggle')!;
    const cartContainer = document.getElementById('cart-items')!;
    const cartTotalEl = document.getElementById('cart-total')!;
    const checkoutBtn = document.getElementById('checkout-wa')!;
    const sizeGuideModal = document.getElementById('size-guide-modal')!;
    const sizeGuideTrigger = document.getElementById('size-guide-trigger')!;
    const sizeGuideClose = document.getElementById('size-guide-close')!;

    const whatsapp = '{site.whatsapp}';

    function updateCartUI() {
      const count = cartItems.reduce((s: number, i: any) => s + i.quantity, 0);
      const total = cartItems.reduce((s: number, i: any) => s + i.price * i.quantity, 0);

      if (count > 0) {
        cartBadge.textContent = String(count);
        cartBadge.classList.remove('hidden');
      } else {
        cartBadge.classList.add('hidden');
      }

      cartTotalEl.textContent = `$${total}`;

      if (cartItems.length === 0) {
        cartContainer.innerHTML = `<p class="text-charcoal-400 text-center py-12">${t.empty}</p>`;
      } else {
        cartContainer.innerHTML = cartItems.map((item: any, idx: number) => `
          <div class="flex gap-3 items-center bg-beige-50 rounded-xl p-3">
            <div class="w-16 h-16 bg-beige-200 rounded-lg flex items-center justify-center text-2xl flex-shrink-0">
              ${item.name.includes('Hoodie') || item.name.includes('卫衣') ? '\uD83E\uDDE5' : item.name.includes('Cap') || item.name.includes('帽') ? '\uD83E\uDDE2' : '\uD83D\uDC55'}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-charcoal-800 truncate">${item.name}</p>
              <p class="text-xs text-charcoal-400">Size: ${item.size} &times; ${item.quantity}</p>
              <p class="text-sm font-semibold text-charcoal-700">$${item.price * item.quantity}</p>
            </div>
            <button data-remove="${idx}" class="text-charcoal-400 hover:text-red-500 text-lg">&times;</button>
          </div>
        `).join('');
      }

      // Bind remove buttons
      document.querySelectorAll('[data-remove]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt((btn as HTMLElement).getAttribute('data-remove')!);
          cartItems.splice(idx, 1);
          updateCartUI();
          saveCart();
        });
      });
    }

    function addToCart(name: string, price: number, size: string, image: string) {
      if (!size) {
        alert('{lang === "en" ? "Please select a size first" : "请先选择尺码"}');
        return;
      }
      const existing = cartItems.find((i: any) => i.name === name && i.size === size);
      if (existing) {
        existing.quantity++;
      } else {
        cartItems.push({ name, price, size, image, quantity: 1 });
      }
      updateCartUI();
      saveCart();
      cartToggle.classList.add('scale-110');
      setTimeout(() => cartToggle.classList.remove('scale-110'), 200);
    }

    function saveCart() {
      localStorage.setItem('pastor-site-cart', JSON.stringify(cartItems));
    }

    function checkout() {
      if (cartItems.length === 0) return;
      const lines = cartItems.map((i: any) => `\u2022 ${i.name} (${i.size}) \u00d7${i.quantity} \u2014 $${i.price * i.quantity}`);
      const total = cartItems.reduce((s: number, i: any) => s + i.price * i.quantity, 0);
      const text = `Hi! I'd like to order:%0A%0A${lines.join('%0A')}%0A%0ATotal: $${total}%0A%0A`;
      window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank');
    }

    // Size selection
    document.querySelectorAll('.size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const productId = el.dataset.product!;
        document.querySelectorAll(`.size-btn[data-product="${productId}"]`).forEach(b => {
          b.classList.remove('border-charcoal-600', 'bg-charcoal-100');
          b.classList.add('border-charcoal-300');
        });
        el.classList.add('border-charcoal-600', 'bg-charcoal-100');
        el.classList.remove('border-charcoal-300');
      });
    });

    // Add to cart
    document.querySelectorAll('.add-to-cart').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const productId = el.dataset.product!;
        const sizeBtn = document.querySelector(`.size-btn[data-product="${productId}"].border-charcoal-600`);
        const size = sizeBtn?.getAttribute('data-size') || '';
        addToCart(el.dataset.name!, Number(el.dataset.price!), size, el.dataset.image!);
      });
    });

    // Cart UI
    cartToggle.addEventListener('click', () => cartDrawer.classList.remove('hidden'));
    cartClose.addEventListener('click', () => cartDrawer.classList.add('hidden'));
    cartOverlay.addEventListener('click', () => cartDrawer.classList.add('hidden'));
    checkoutBtn.addEventListener('click', checkout);

    // Size guide modal
    sizeGuideTrigger.addEventListener('click', () => sizeGuideModal.classList.remove('hidden'));
    sizeGuideClose.addEventListener('click', () => sizeGuideModal.classList.add('hidden'));
    sizeGuideModal.addEventListener('click', (e) => {
      if (e.target === sizeGuideModal) sizeGuideModal.classList.add('hidden');
    });

    // Load saved cart
    try {
      const saved = localStorage.getItem('pastor-site-cart');
      if (saved) {
        const parsed = JSON.parse(saved);
        cartItems.push(...parsed);
      }
    } catch(e) {}

    updateCartUI();
  }

  initProductCarousel();
  document.addEventListener('astro:page-load', initProductCarousel);
</script>
