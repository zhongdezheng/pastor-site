<!--
============================================================
📁 文件位置: src/pages/zh/testimonies/index.astro
🌐 路由: /zh/testimonies/
🎯 作用: 见证列表页 — 展示所有见证的标题列表，点击进入详情
📝 修改指南:
   【修改】见证数据：编辑 src/content/testimonies.json
   【修改】列表项样式：改 <a> 的 Tailwind class
   【修改】编号格式：改 idx+1 的显示方式
   【修改】分隔符：改 "——" 符号
   【修改】日期/作者格式：改 t.date + ' · ' + t.author.zh
   【修改】列表无数据状态：加 t.length===0 的空状态
============================================================
-->
---
// ── 导入 ────────────────────────────────────────────────────
import BaseLayout from '../../../layouts/BaseLayout.astro';   // 全局布局
// ⚡ 构建时从管理后台 API 获取见证，失败则回退本地 JSON
let testimonies = [];
try {
  const res = await fetch('http://localhost:5200/api/testimonies');
  if (res.ok) {
    testimonies = (await res.json())
      .filter(t => t.published !== 0)
      .map(t => ({
        id: t.id,
        title: { en: t.title_en || t.title || "", zh: t.title_zh || t.title || "" },
        date: t.date || "",
        author: { en: t.author || "", zh: t.author || "" },
        excerpt: { en: t.excerpt_en || "", zh: t.excerpt_zh || "" },
        content: { en: t.content_en || t.content || "", zh: t.content_zh || t.content || "" },
      }));
  }
} catch(e) {}
if (!testimonies.length) {
  testimonies = (await import('../../../content/testimonies.json')).default;
}  // 见证数据（数组）
---

<BaseLayout lang="zh" title="信心见证 | 活石">
  <!-- 【主容器】米色背景、全高 -->
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <!-- 【标题】 -->
    <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 text-center mb-2">见证</h1>
    <!-- 【副标题】 -->
    <p class="text-charcoal-400 text-sm text-center mb-12">信心与蜕变的故事</p>

    <!-- 【见证列表】垂直排列，底部边框分隔 -->
    <div class="space-y-1">
        {testimonies.map((t, idx) => (
          <a href={`/zh/testimonies/${t.id}/`} class="block py-4 border-b border-beige-200 hover:bg-beige-50/50 transition-colors">
            <p class="text-charcoal-800 text-sm sm:text-base text-left">
              <span class="text-charcoal-500 font-medium">{idx + 1}.</span>
              <span class="font-serif font-bold">{t.title.zh}</span>
              <span class="text-charcoal-500 mx-1">——</span>
              <span class="text-charcoal-400">{t.date} · {t.author.zh}</span>
            </p>
          </a>
        ))}
      </div>
    </section>
</BaseLayout>
