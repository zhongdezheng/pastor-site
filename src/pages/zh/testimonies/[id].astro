<!--
============================================================
📁 文件位置: src/pages/zh/testimonies/[id].astro
🌐 路由: /zh/testimonies/:id/    (动态路由)
🎯 作用: 见证详情页 — 展示单篇见证的完整内容（标题/作者/日期/正文）
📝 修改指南:
   【修改】见证数据：编辑 src/content/testimonies.json
   【修改】内容分割：改 t.content.zh.split('\n\n') 分隔符
   【修改】返回链接文案：改 "返回见证" 文本
   【修改】文章卡片样式：改 article 的 Tailwind class
   【修改】作者署名格式：改 footer 中的 "— {t.author.zh}"
   【修改】404处理：改 Astro.redirect 的目标路径
============================================================
-->
---
// ── 导入 ────────────────────────────────────────────────────
import BaseLayout from '../../../layouts/BaseLayout.astro';   // 全局布局
// ⚡ 构建时从 API 获取，供模板渲染
let testimonies = [];
try {
  const res = await fetch('http://localhost:5200/api/testimonies');
  if (res.ok) {
    testimonies = (await res.json())
      .filter(t => t.published !== 0)
      .map(t => ({
        id: t.id,
        title: { en: t.title_en || t.title || "", zh: t.title_zh || t.title || "" },
        date: t.date || "",
        author: { en: t.author || "", zh: t.author || "" },
        excerpt: { en: t.excerpt_en || "", zh: t.excerpt_zh || "" },
        content: { en: t.content_en || t.content || "", zh: t.content_zh || t.content || "" },
      }));
  }
} catch(e) {}
if (!testimonies.length) {
  testimonies = (await import('../../../content/testimonies.json')).default;
}  // 见证数据

// 【静态路径】为每篇见证预生成页面（SSG）
export async function getStaticPaths() {
  let testimonies = [];
  try {
    const res = await fetch('http://localhost:5200/api/testimonies');
    if (res.ok) {
      testimonies = (await res.json())
        .filter(t => t.published !== 0)
        .map(t => ({
          id: t.id,
          title: { en: t.title_en || t.title || "", zh: t.title_zh || t.title || "" },
          date: t.date || "",
          author: { en: t.author || "", zh: t.author || "" },
          excerpt: { en: t.excerpt_en || "", zh: t.excerpt_zh || "" },
          content: { en: t.content_en || t.content || "", zh: t.content_zh || t.content || "" },
        }));
    }
  } catch(e) {}
  if (!testimonies.length) {
    testimonies = (await import('../../../content/testimonies.json')).default;
  }
  return testimonies.map(t => ({ params: { id: String(t.id) } }));
}

// 【路由参数】从URL取 id，转为数字
const id = Number(Astro.params.id);
// 【查找见证】根据 id 匹配
const t = testimonies.find(tm => tm.id === id);
// 【404处理】找不到则重定向到见证列表
if (!t) return Astro.redirect('/zh/testimonies/');
---

<BaseLayout lang="zh" title={`${t.title.zh} | 活石`}>
  <!-- 【主容器】米色背景 -->
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <!-- 【返回链接】带左箭头SVG图标 -->
      <a href="/zh/testimonies/" class="inline-flex items-center gap-1 text-charcoal-400 hover:text-sage-500 text-sm transition-colors mb-12">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        返回见证
      </a>

      <!-- 【文章卡片】白色圆角、阴影 -->
      <article class="bg-white rounded-2xl shadow-lg border border-beige-200 p-8 md:p-12">
        <!-- 【文章头】标题 + 日期 + 作者 -->
        <header class="mb-10">
          <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-3">{t.title.zh}</h1>
          <p class="text-charcoal-400 text-sm">{t.date} &middot; {t.author.zh}</p>
        </header>

        <!-- 【正文】按段落分割渲染 — 【修改】分隔符改 split('\n\n') -->
        <div class="text-charcoal-700 leading-relaxed font-serif text-xl">
          {t.content.zh.split('\n\n').map(para => <p class="mb-6">{para}</p>)}
        </div>

        <!-- 【文章尾】作者署名 -->
        <footer class="mt-12 pt-6 border-t border-beige-200">
          <p class="text-charcoal-400 text-sm italic">— {t.author.zh}</p>
        </footer>
      </article>
      <!-- 📚 见证目录：列出所有见证，当前页高亮 -->
      <nav class="mt-12">
        <h2 class="text-lg font-serif font-bold text-charcoal-800 mb-4">更多见证</h2>
        <div class="space-y-1">
          {testimonies.map((tm, idx) => (
            <a href={`/zh/testimonies/${tm.id}/`} class={`block py-3 px-4 rounded-lg border transition-colors ${tm.id === id ? 'bg-sage-50 border-sage-200 text-sage-700 font-bold' : 'border-beige-200 hover:bg-beige-50 text-charcoal-700'}`}>
              <span class="text-charcoal-400 text-sm mr-2">{idx + 1}.</span>
              <span class="font-serif">{tm.title.zh}</span>
              <span class="text-charcoal-400 text-xs ml-2">{tm.date}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
    </div>
  </section>
</BaseLayout>
