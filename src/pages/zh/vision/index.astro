---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import visionData from '../../../content/vision.json';
const v = visionData.zh;
const paragraphs = v.content.split('\n\n').filter(p => p.trim());
---

<BaseLayout lang="zh" title={`${v.title} — 活石`}>
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="block w-12 h-px bg-beige-400"></span>
        <span class="text-beige-400 text-lg">✦</span>
        <span class="block w-12 h-px bg-beige-400"></span>
      </div>
      <h1 class="text-2xl md:text-3xl font-serif font-bold text-charcoal-900 text-center mb-6">{v.title}</h1>
      <div class="flex justify-center mb-10">
        <iframe src="/vision-globe.html" class="w-full max-w-[500px] aspect-square border-0" style="background:transparent;" title="Global Vision Globe"></iframe>
      </div>
      <article class="bg-white rounded-2xl shadow-lg border border-beige-200 p-8 md:p-12">
        <div class="text-charcoal-700 leading-relaxed font-serif text-lg space-y-6">
          {paragraphs.map(p => <p>{p}</p>)}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
