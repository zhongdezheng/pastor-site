---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import siteData from '../../../content/site.json';
const { site } = siteData;
---

<BaseLayout lang="zh" title="联系我们 — 光与恩典">
  <section class="py-24 lg:py-32 px-6 bg-cream-50 min-h-screen">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="section-title text-clay-900">联系我们</h2>
      <p class="section-subtitle mb-16">期待与你交流。随时联系我们。</p>

      <div class="space-y-8">
        <!-- WhatsApp -->
        <a href={`https://wa.me/${site.whatsapp}?text=你好！我访问了你的网站，想了解更多。`}
           target="_blank" rel="noopener"
           class="block bg-white rounded-2xl shadow-lg border border-cream-200 p-8 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            💬
          </div>
          <h3 class="font-serif text-xl font-bold text-clay-800 mb-2">WhatsApp</h3>
          <p class="text-clay-500 text-sm">最快联系我们的方式 — 直接在 WhatsApp 对话</p>
        </a>

        <!-- Email -->
        <a href={`mailto:${site.email}`}
           class="block bg-white rounded-2xl shadow-lg border border-cream-200 p-8 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 mx-auto mb-4 bg-clay-100 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            ✉️
          </div>
          <h3 class="font-serif text-xl font-bold text-clay-800 mb-2">邮箱</h3>
          <p class="text-clay-500 text-sm">{site.email}</p>
        </a>

        <!-- Prayer -->
        <a href="/zh/prayer/"
           class="block bg-white rounded-2xl shadow-lg border border-cream-200 p-8 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 mx-auto mb-4 bg-clay-100 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            🙏
          </div>
          <h3 class="font-serif text-xl font-bold text-clay-800 mb-2">代祷需求</h3>
          <p class="text-clay-500 text-sm">提交代祷需求 — 我们为每一条祷告</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
