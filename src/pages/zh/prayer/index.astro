---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" title="代祷 — 活石">
  <section class="pt-24 pb-16 px-4 sm:px-6" style="background: linear-gradient(180deg, #fefcf5 0%, #f0ece0 100%);">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal-900 text-center mb-4">代祷</h1>
      <p class="text-center text-charcoal-600 leading-relaxed max-w-2xl mx-auto mb-10 text-sm sm:text-base">
        主内深交，不至隔绝。无论你正在经历职场的试炼、家庭的重担，还是事工的旷野，请将你的代祷题目留下来。身处这片土地，我和同工们愿意在每一天的祭坛前为你守望，在主里一同担当你的重担。你并不孤单。
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div class="flex justify-center">
          <iframe src="/prayer-globe.html" class="w-full max-w-[480px] aspect-square border-0" style="background:transparent;" title="Prayer Globe"></iframe>
        </div>
        <div class="w-full max-w-md mx-auto">
          <form id="prayer-form" class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-beige-200 space-y-3">
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">姓名</label>
              <input type="text" name="name" placeholder="你的名字（选填）" class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">邮箱</label>
              <input type="email" name="email" placeholder="你的邮箱" class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">你的国家 *</label>
              <input type="text" name="country" required placeholder="例如：中国、美国、肯尼亚..." class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">代祷事项 *</label>
              <textarea name="request" rows="6" required placeholder="分享你心中所想..." class="w-full px-4 py-3 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-sage-500 hover:bg-sage-600 text-white font-medium rounded-xl transition-colors">发送代祷</button>
            <p id="prayer-error" class="text-red-500 text-xs text-center hidden"></p>
          </form>
          <div id="prayer-success" class="hidden mt-4 bg-sage-50 border border-sage-200 rounded-2xl p-6 text-center">
            <p class="text-4xl mb-2">🙏</p><p class="text-sage-600 text-sm">你的代祷已收到。我们在为你祷告。</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function(){
  var f = document.getElementById('prayer-form');
  if (!f) return;
  var s = document.getElementById('prayer-success');
  var err = document.getElementById('prayer-error');
  var b = f.querySelector('button');

  f.addEventListener('submit', async function(e) {
    e.preventDefault();
    var d = new FormData(f);
    var country = (d.get('country')||'').trim();
    var request = (d.get('request')||'').trim();
    if (!country || !request) return;

    b.textContent = '发送中...';
    b.disabled = true;
    err.classList.add('hidden');

    try {
      var res = await fetch('https://admin.pastorjeffnchina.com/api/prayers', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({name: d.get('name')||'', email: d.get('email')||'', content: country + ': ' + request})
      });
      if (!res.ok) throw new Error('fail');
      f.classList.add('hidden');
      s.classList.remove('hidden');
    } catch(e) {
      err.textContent = '发送失败，请重试。';
      err.classList.remove('hidden');
    } finally {
      b.textContent = '发送代祷';
      b.disabled = false;
    }
  });
})();
</script>
