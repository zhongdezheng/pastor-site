---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
const toolUrl = "__TOOL_URL__";
const isZh = true;
const t = { kicker: "免费工具", use: "开始使用", soon: "即将上架 · 敬请留意", local: "本地运行 · 数据不上传", free: "完全免费", by: "由 Jeff（在职牧师）开发并在自己的教会日常使用", sub: "订阅Jeff的工具与灵修通讯", subDesc: "新工具上架、使用技巧、每月一封，不发广告。", namePh: "你的名字", contactPh: "微信 / WhatsApp / 邮箱", btn: "订阅", ok: "已收到！Jeff 会尽快与你联系。", err: "提交失败，请稍后再试或直接邮件联系。" };
---
<BaseLayout lang="zh" title="免费工具 — 服事排班表 | Livingstone" description="敬拜/接待/音控排班管理，冲突提醒，一键导出。">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">免费工具</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">服事排班表</h1>
      <p class="text-charcoal-600 text-lg mb-8">敬拜/接待/音控排班管理，冲突提醒，一键导出。</p>
      <div class="flex flex-wrap gap-3 mb-4">
        <span class="text-xs font-medium px-3 py-1 rounded-full bg-sage-100 text-sage-800 border border-sage-200">✓ 完全免费</span>
        <span class="text-xs font-medium px-3 py-1 rounded-full bg-beige-100 text-charcoal-600 border border-beige-200">🔒 本地运行 · 数据不上传</span>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-beige-200 p-6 mb-10">
        <p class="text-charcoal-500 text-sm italic mb-5">由 Jeff（在职牧师）开发并在自己的教会日常使用</p>
        <p id="soon-note" class="text-charcoal-400 text-xs">即将上架 · 敬请留意</p>
      </div>

      <div class="bg-charcoal-800 rounded-2xl p-7 text-white">
        <h2 class="text-lg font-serif font-bold mb-2">订阅Jeff的工具与灵修通讯</h2>
        <p class="text-charcoal-200 text-sm mb-5">新工具上架、使用技巧、每月一封，不发广告。</p>
        <form id="sub-form" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="text" name="name" required maxlength="100" placeholder="你的名字" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <input type="text" name="contact" required maxlength="200" placeholder="微信 / WhatsApp / 邮箱" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <button type="submit" class="bg-sage-600 hover:bg-sage-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">订阅</button>
        </form>
        <p id="sub-msg" class="hidden text-sage-300 text-sm mt-3"></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var f = document.getElementById('sub-form');
      var msg = document.getElementById('sub-msg');
      if (!f) return;
      f.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(f);
        var isZh = document.documentElement.lang === 'zh';
        fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            website: fd.get('website') || '',
            name: fd.get('name'),
            contact: fd.get('contact'),
            materials: ['newsletter'],
            message: isZh ? '订阅工具与灵修通讯' : 'Subscribe to tools & devotional newsletter',
            lang: isZh ? 'zh' : 'en'
          })
        }).then(function(r) { return r.json(); }).then(function(d) {
          var m = document.getElementById('sub-msg');
          m.textContent = d && d.success ? "已收到！Jeff 会尽快与你联系。" : "提交失败，请稍后再试或直接邮件联系。";
          m.classList.remove('hidden');
          if (d && d.success) f.reset();
        }).catch(function() {
          var m = document.getElementById('sub-msg');
          m.textContent = "提交失败，请稍后再试或直接邮件联系。";
          m.classList.remove('hidden');
        });
      });
    })();
  </script>
</BaseLayout>
