---
// 免费工具总览页（推广方案 §03 工具区）· 2026-11-11
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout lang="zh" title="免费工具 — 牧师开发 · 教会实用 | Livingstone" description="代祷清单、听道笔记、查经工作表、读经计划等 8 个免费教会工具——由在职牧师开发，自己教会每天在用，数据不上传。">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">免费工具</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">牧师开发 · 教会实用</h1>
      <p class="text-charcoal-600 text-lg mb-12">我是 Jeff，一位在中国工厂上班的牧师。这 8 个小工具都是我先在自己教会用起来，才敢给你的——完全免费，数据全部存在你自己的设备上，不上传服务器。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href="/zh/tools/prayer-list/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">代祷清单管理器</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">代祷事项管理 · 记录应答 · 打印清单</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/sermon-notes/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">听道笔记</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">讲道要点 · 经文 · 应用，永久保存</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/bible-worksheet/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">查经工作表</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">观察-解释-应用 三步结构化</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/reading-plan/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">读经计划生成器</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">自定义范围与起止日期</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/verse-memorizer/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">经文背诵练习器</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">关键词渐进隐藏背诵法</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/church-poster/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">教会海报生成器</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">聚会预告与节日海报模板</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/church-calendar/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">教会节期日历</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">将临期/圣诞/复活节自动计算</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
        <a href="/zh/tools/roster/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">服事排班表</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">敬拜/接待/音控排班与冲突提醒</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ 完全免费 · 数据不上传</p>
        </a>
      </div>

      <div class="bg-charcoal-800 rounded-2xl p-7 text-white mt-12">
        <h2 class="text-lg font-serif font-bold mb-2">订阅 Jeff 的工具与灵修通讯</h2>
        <p class="text-charcoal-200 text-sm mb-5">新工具上架、使用技巧，每月一封，不发广告。</p>
        <form id="sub-form" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="text" name="name" required maxlength="100" placeholder="你的名字" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <input type="text" name="contact" required maxlength="200" placeholder="微信 / WhatsApp / 邮箱" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <button type="submit" class="bg-sage-600 hover:bg-sage-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">订阅</button>
        </form>
        <p id="sub-msg" class="hidden text-sage-300 text-sm mt-3"></p>
      </div>
    </div>
  </section>

  <script>
    (function(){
      var f = document.getElementById('sub-form');
      var msg = document.getElementById('sub-msg');
      if (!f) return;
      f.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(f);
        fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ website: fd.get('website') || '', name: fd.get('name'), contact: fd.get('contact'), materials: ['newsletter'], message: '订阅工具与灵修通讯（工具总览页）', lang: 'zh' }) })
        .then(function(r){ return r.json(); }).then(function(d){
          msg.textContent = d && d.success ? '已收到！Jeff 会尽快与你联系。' : '提交失败，请稍后再试或直接邮件联系。';
          msg.classList.remove('hidden');
          if (d && d.success) f.reset();
        }).catch(function(){
          msg.textContent = '提交失败，请稍后再试或直接邮件联系。';
          msg.classList.remove('hidden');
        });
      });
    })();
  </script>
</BaseLayout>
