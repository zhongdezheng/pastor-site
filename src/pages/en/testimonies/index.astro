---
/**
 * 📍 文件位置: src/pages/en/testimonies/index.astro
 * 🌐 路由: /en/testimonies/
 * 🎯 作用: 英文见证列表页——从 content/testimonies.json 读取全部见证，以编号列表形式展示，点击跳转详情
 * 🔧 修改指南:
 *   - 修改见证内容：编辑 content/testimonies.json
 *   - 修改列表样式：调整下方 <a> 标签的 Tailwind 类名
 *   - 编号为自然序号 (idx + 1)，非数据库 ID
 *   - 见证日期格式：JSON 中 date 字段直接渲染
 *   - 每项为链接，指向 /en/testimonies/:id/
 */

// 【修改】引入基础布局
import BaseLayout from '../../../layouts/BaseLayout.astro';
// 【修改】引入见证数据（JSON 数组，每项含 id/title/author/date/content）
import testimonies from '../../../content/testimonies.json';
---

<BaseLayout lang="en" title="Testimonies — Livingstone">
  <!-- 📖 见证列表页主容器 -->
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <!-- 📌 页面标题 -->
    <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 text-center mb-2">Testimonies</h1>
    <!-- ✍️ 页面说明 -->
    <p class="text-charcoal-400 text-sm text-center mb-12">Stories of faith and transformation</p>

    <!-- 📋 见证列表（简洁竖排 + 底部分隔线） -->
    <div class="space-y-1">
        {testimonies.map((t, idx) => (
          <a href={`/en/testimonies/${t.id}/`} class="block py-4 border-b border-beige-200 hover:bg-beige-50/50 transition-colors">
            <p class="text-charcoal-800 text-sm sm:text-base text-left"><span class="text-charcoal-500 font-medium">{idx + 1}.</span> <span class="font-serif font-bold">{t.title.en}</span><span class="text-charcoal-500 mx-1">——</span><span class="text-charcoal-400">{t.date} · {t.author.en}</span></p>
          </a>
        ))}
      </div>
    </section>
</BaseLayout>
