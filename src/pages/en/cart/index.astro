---
/**
 * 📍 文件位置: src/pages/en/cart/index.astro
 * 🌐 路由: /en/cart/
 * 🎯 作用: 英文购物车页面——展示已添加商品、修改数量/删除、PayPal 支付结账
 * 🔧 修改指南:
 *   - 购物车数据来源：localStorage key "ps-cart"，与产品详情页共享
 *   - PayPal 配置：fetch https://admin.pastorjeffnchina.com/api/paypal/config 获取 clientId + mode
 *   - PayPal SDK 加载：动态插入 script 标签，根据 mode 决定 sandbox 参数
 *   - 支付流程：创建订单 → 用户确认 → 捕获订单 → 清空购物车
 *   - 产品名称获取：PRODUCTS 数组中查找，优先取 name.en
 *   - 修改按钮样式：搜索 paypal.Buttons() 中的 style 对象
 */

// 【修改】引入基础布局
import BaseLayout from '../../../layouts/BaseLayout.astro';
// 【修改】引入产品数据（用于根据购物车中的 id 查找产品名称/图片）
import products from '../../../content/products.json';
---

<BaseLayout lang="en" title="Cart — Livingstone">
  <!-- 🛒 购物车主容器 -->
  <section class="pt-24 pb-16 px-4 sm:px-6 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto">
      <!-- ↩️ 返回产品列表（初始链接，render 时动态更新为最后一件商品的链接） -->
      <a href="/en/products/" id="cart-back-link" class="text-sm text-charcoal-500 hover:text-charcoal-700 mb-6 inline-block">&larr; Return to Products</a>
      <!-- 📌 页面标题 -->
      <h1 class="font-serif text-2xl font-bold text-charcoal-800 mb-8">Shopping Cart</h1>
      <!-- 📦 注入产品数据供 script 读取 -->
      <script type="application/json" id="__cartProducts" set:html={JSON.stringify(products)}></script>
      <!-- 📋 购物车商品列表（render() 动态填充） -->
      <div id="cart-items"><p class="text-charcoal-400 text-center py-12">Your cart is empty</p></div>
      <!-- 🧾 购物车底部：总计 + PayPal 支付按钮（初始隐藏，有商品时才展示） -->
      <div id="cart-footer" class="hidden mt-6 pt-6 border-t border-beige-200">
        <!-- 💰 总金额 -->
        <div class="flex justify-between text-lg font-bold text-charcoal-800 mb-4"><span>Total</span><span id="cart-total">$0</span></div>

        <!-- 💳 PayPal + Cards + Apple Pay 按钮容器 -->
        <div id="paypal-button-container" class="mb-3"></div>
        <!-- ❌ 支付错误提示 -->
        <p id="payment-error" class="text-red-500 text-xs text-center hidden mt-2"></p>
        <!-- ✅ 支付成功提示 -->
        <p id="payment-success" class="hidden mt-2 text-center text-green-600 text-sm"></p>
      </div>
    </div>
  </section>
</BaseLayout>

<!-- 🤖 购物车 + PayPal 支付逻辑（is:inline） -->
<script is:inline>
  // 📦 DOM 元素引用
  var paypalContainer=document.getElementById('paypal-button-container'),paypalError=document.getElementById('payment-error'),paypalSuccess=document.getElementById('payment-success'),cartItems=document.getElementById('cart-items'),cartFooter=document.getElementById('cart-footer'),cartTotal=document.getElementById('cart-total'),backLink=document.getElementById('cart-back-link');
  // 📦 产品数据（用于查找名称和图片）
  var PRODUCTS=JSON.parse(document.getElementById('__cartProducts').textContent);
  // 🛒 读取 localStorage 购物车
  function getCart(){return JSON.parse(localStorage.getItem('ps-cart')||'[]');}
  function saveCart(c){localStorage.setItem('ps-cart',JSON.stringify(c));}
  // 📛 获取产品英文名称
  function getProductName(i){
    var p=PRODUCTS.find(function(x){return x.id===i.id;});
    if(p&&p.name) return typeof p.name==='string' ? p.name : (p.name.en||'');
    var n=i.name;
    if(typeof n==='string') return n;
    if(n&&n.en) return n.en;
    return 'Product';
  }
  // 🖼️ 获取产品图片
  function getProductImage(i){
    var p=PRODUCTS.find(function(x){return x.id===i.id;});
    if(p&&p.images&&p.images.length) return p.images[0];
    if(i.image) return i.image;
    return '';
  }
  // 🔗 获取产品 slug（用于跳转链接）
  function getProductSlug(i){
    return i.slug||i.id||'';
  }
  // 🖼️ 渲染购物车列表
  function render(){
    var c=getCart();
    // 空购物车 → 显示空状态
    if(!c.length){cartItems.innerHTML='<p class="text-charcoal-400 text-center py-12">Your cart is empty</p>';cartFooter.classList.add('hidden');backLink.href='/en/products/';return;}
    cartFooter.classList.remove('hidden');
    // 💰 计算总金额
    var t=c.reduce(function(s,i){return s+i.price*i.quantity;},0);cartTotal.textContent='$'+t.toFixed(2);
    // ↩️ 返回链接指向最后一件商品
    var last=c[c.length-1];backLink.href='/en/products/'+(last.slug||last.id||'tee-180g')+'/';
    // 🛒 逐项渲染购物车商品
    cartItems.innerHTML=c.map(function(i,idx){
      var src=getProductImage(i);
      var name=getProductName(i);
      var slug=getProductSlug(i);
      var imgHtml=src ? '<img src="'+src+'" style="width:100%;height:100%;object-fit:cover" onerror="this.parentElement.innerHTML=\'&#x1F455;\'">' : '&#x1F455;';
      return '<div class="flex gap-4 items-center bg-beige-50 rounded-xl p-4 mb-3">'
        // 商品缩略图
        +'<div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-beige-200 flex items-center justify-center">'+imgHtml+'</div>'
        +'<div class="flex-1 min-w-0">'
        // 商品名称（可点击跳转）
        +'<a href="/en/products/'+slug+'/" class="text-sm font-bold text-charcoal-800 truncate hover:text-red-500">'+name+'</a>'
        // 颜色 + 尺码
        +'<p class="text-xs text-charcoal-400">Color: '+(i.color||'White')+' | Size: '+(i.size||'M')+'</p>'
        // 数量加减
        +'<div class="flex items-center gap-2 mt-2">'
        +'<button class="w-7 h-7 border border-charcoal-300 rounded-lg text-sm flex items-center justify-center hover:bg-beige-100" onclick="changeQty('+idx+',-1)">−</button>'
        +'<span class="text-sm font-bold w-6 text-center">'+i.quantity+'</span>'
        +'<button class="w-7 h-7 border border-charcoal-300 rounded-lg text-sm flex items-center justify-center hover:bg-beige-100" onclick="changeQty('+idx+',1)">+</button>'
        +'</div></div><div class="text-right">'
        // 单项小计
        +'<p class="text-sm font-bold text-charcoal-800">$'+(i.price*i.quantity).toFixed(2)+'</p>'
        // 🗑️ 删除按钮
        +'<button class="text-xs text-red-400 hover:text-red-600 mt-1" onclick="removeItem('+idx+')">Remove</button></div></div>';
    }).join('');
    // 💳 初始化 PayPal 支付
    initPayPal();
  }
  // ➕➖ 修改商品数量
  window.changeQty=function(idx,d){var c=getCart();c[idx].quantity=Math.max(1,c[idx].quantity+d);saveCart(c);render();};
  // 🗑️ 删除商品
  window.removeItem=function(idx){var c=getCart();c.splice(idx,1);saveCart(c);render();};

  // 💳 PayPal 状态标志
  var paypalLoaded=false, paypalButtons=false;
  function initPayPal(){
    if(paypalButtons) return;
    var c=getCart();
    if(!c.length) return;
    paypalContainer.innerHTML='<p class="text-charcoal-400 text-sm text-center py-4">Loading payment options...</p>';
    // 🔗 获取 PayPal 配置（clientId + mode）
    fetch('https://admin.pastorjeffnchina.com/api/paypal/config')
    .then(function(r){return r.json();})
    .then(function(cfg){
      if(!cfg.enabled || !cfg.clientId){
        paypalContainer.innerHTML='<p class="text-charcoal-400 text-sm text-center py-2">Payment is temporarily unavailable</p>';
        return;
      }
      loadPayPalSDK(cfg.clientId, cfg.mode);
    }).catch(function(){
      paypalContainer.innerHTML='<p class="text-charcoal-400 text-sm text-center py-2">Payment is temporarily unavailable</p>';
    });
  }

  // 📥 动态加载 PayPal SDK
  function loadPayPalSDK(clientId, mode){
    if(paypalLoaded){ renderButtons(); return; }
    paypalLoaded=true;
    var s=document.createElement('script');
    s.src='https://www.paypal.com/sdk/js?client-id='+clientId+'&currency=USD&intent=capture&disable-funding=credit&components=buttons';
    // 🧪 sandbox 模式添加 buyer-country 参数
    if(mode==='sandbox') s.src+='&buyer-country=US';
    s.onload=renderButtons;
    s.onerror=function(){ paypalContainer.innerHTML='<p class="text-red-500 text-sm text-center py-2">Failed to load payment. Please refresh.</p>'; };
    document.head.appendChild(s);
  }

  // 🎨 渲染 PayPal 按钮
  function renderButtons(){
    var c=getCart();
    if(!c.length) return;
    paypalContainer.innerHTML='';
    paypalButtons=true;
    paypal.Buttons({
      style: { layout:'vertical', color:'gold', shape:'rect', label:'paypal' },
      // 📝 创建订单 → POST 到后台 API
      createOrder: function(data,actions){
        var cart=getCart();
        return fetch('https://admin.pastorjeffnchina.com/api/paypal/create-order',{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({items:cart.map(function(i){return {name:i.name||'Product',price:i.price,quantity:i.quantity,slug:i.slug||i.id};})})
        }).then(function(r){return r.json();}).then(function(data){
          if(data.error){ paypalError.textContent='Payment error: '+data.error; paypalError.classList.remove('hidden'); throw new Error(data.error); }
          return data.id;
        });
      },
      // ✅ 支付成功 → 捕获订单
      onApprove: function(data,actions){
        paypalContainer.innerHTML='<p class="text-charcoal-400 text-sm text-center py-4">Processing payment...</p>';
        var cart=getCart();
        return fetch('https://admin.pastorjeffnchina.com/api/paypal/capture-order',{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({orderID:data.orderID, items:cart.map(function(i){return {name:i.name||'Product',price:i.price,quantity:i.quantity,slug:i.slug||i.id,color:i.color,size:i.size};})})
        }).then(function(r){return r.json();}).then(function(result){
          if(result.error){ paypalError.textContent='Payment failed. Please try again.'; paypalError.classList.remove('hidden'); return; }
          // 🎉 支付成功 → 清空购物车
          localStorage.removeItem('ps-cart');
          paypalSuccess.innerHTML='<div class="bg-green-50 border border-green-200 rounded-xl p-4"><p class="text-lg mb-1">🎉 Payment successful!</p><p class="text-sm">Thank you for your purchase.</p></div>';
          paypalSuccess.classList.remove('hidden');
          render();
        }).catch(function(e){
          paypalError.textContent='Payment failed. Please try again.';
          paypalError.classList.remove('hidden');
        });
      },
      // ❌ 支付错误处理
      onError: function(err){
        paypalError.textContent='Payment error. Please try again later.';
        paypalError.classList.remove('hidden');
      }
    }).render('#paypal-button-container');
  }
  // 🚀 初始渲染
  render();
</script>
