---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Cart — Livingstone">
  <section class="pt-24 pb-16 px-4 sm:px-6 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto">
      <a href="/en/products/" class="text-sm text-charcoal-500 hover:text-charcoal-700 mb-6 inline-block">&larr; Return to Products</a>
      <h1 class="font-serif text-2xl font-bold text-charcoal-800 mb-8">Shopping Cart</h1>
      <div id="cart-items"><p class="text-charcoal-400 text-center py-12">Your cart is empty</p></div>
      <div id="cart-footer" class="hidden mt-6 pt-6 border-t border-beige-200">
        <div class="flex justify-between text-lg font-bold text-charcoal-800 mb-4"><span>Total</span><span id="cart-total">$0</span></div>
        <button id="checkout-paypal" class="w-full py-3 bg-[#0070ba] hover:bg-[#005ea6] text-white rounded-xl font-medium text-sm transition-colors">Pay with PayPal</button>
        <div id="paypal-input" class="hidden mt-3 p-4 bg-beige-50 rounded-xl">
          <p class="text-sm font-semibold text-charcoal-800 mb-2">PayPal Payment</p>
          <p class="text-xs text-charcoal-500 mb-3">Enter your PayPal email and we will send you a payment request.</p>
          <div class="flex gap-2">
            <input type="email" id="paypal-email" placeholder="your@paypal.com" class="flex-1 px-3 py-2 border border-beige-300 rounded-lg text-sm">
            <button id="paypal-send" class="px-4 py-2 bg-[#0070ba] hover:bg-[#005ea6] text-white rounded-lg text-sm font-medium">Send Request</button>
          </div>
          <p class="text-xs text-charcoal-400 mt-2" id="paypal-msg"></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  var paypalInput=document.getElementById('paypal-input'),paypalSend=document.getElementById('paypal-send'),paypalMsg=document.getElementById('paypal-msg'),paypalEmail=document.getElementById('paypal-email'),cartItems=document.getElementById('cart-items'),cartFooter=document.getElementById('cart-footer'),cartTotal=document.getElementById('cart-total');
  function getCart(){return JSON.parse(localStorage.getItem('ps-cart')||'[]');}
  function saveCart(c){localStorage.setItem('ps-cart',JSON.stringify(c));}
  function render(){
    var c=getCart();
    if(!c.length){cartItems.innerHTML='<p class="text-charcoal-400 text-center py-12">Your cart is empty</p>';cartFooter.classList.add('hidden');return;}
    cartFooter.classList.remove('hidden');
    var t=c.reduce(function(s,i){return s+i.price*i.quantity;},0);cartTotal.textContent='$'+t.toFixed(2);
    cartItems.innerHTML=c.map(function(i,idx){return '<div class="flex gap-4 items-center bg-beige-50 rounded-xl p-4 mb-3"><div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-beige-200 flex items-center justify-center"><img src="/images/products/180g-tee/962802505245275392_'+ (i.color==='Black'||i.color==='黑色'?'黑色':'白色') +'_3.jpeg" alt="" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML=\'👕\'"></div><div class="flex-1 min-w-0"><p class="text-sm font-bold text-charcoal-800 truncate">180g Men\'s Crew Neck T-Shirt</p><p class="text-xs text-charcoal-400">Color: '+i.color+' | Size: '+i.size+'</p><div class="flex items-center gap-2 mt-2"><button class="w-7 h-7 border border-charcoal-300 rounded-lg text-sm flex items-center justify-center hover:bg-beige-100" onclick="changeQty('+idx+',-1)">−</button><span class="text-sm font-bold w-6 text-center">'+i.quantity+'</span><button class="w-7 h-7 border border-charcoal-300 rounded-lg text-sm flex items-center justify-center hover:bg-beige-100" onclick="changeQty('+idx+',1)">+</button></div></div><div class="text-right"><p class="text-sm font-bold text-charcoal-800">$'+(i.price*i.quantity).toFixed(2)+'</p><button class="text-xs text-red-400 hover:text-red-600 mt-1" onclick="removeItem('+idx+')">Remove</button></div></div>';}).join('');}
  window.changeQty=function(idx,d){var c=getCart();c[idx].quantity=Math.max(1,c[idx].quantity+d);saveCart(c);render();};
  window.removeItem=function(idx){var c=getCart();c.splice(idx,1);saveCart(c);render();};
  document.getElementById('checkout-paypal').onclick=function(){paypalInput.classList.toggle('hidden');};
  paypalSend.onclick=function(){
    var e=paypalEmail.value.trim();if(!e){alert('Enter PayPal email');return;}
    var c=getCart(),t=c.reduce(function(s,i){return s+i.price*i.quantity;},0);
    var l=['Shopping Cart Order:',''];c.forEach(function(i){l.push('180g Men\'s Crew Neck T-Shirt — '+i.color+' '+i.size+' ×'+i.quantity+' — $'+(i.price*i.quantity).toFixed(2));});
    l.push('');l.push('Total: $'+t.toFixed(2));l.push('PayPal: '+e);
    window.open('https://wa.me/8613602812927?text='+encodeURIComponent(l.join('\n')),'_blank');
    paypalMsg.textContent='Request sent! We will contact you at '+e+' shortly.';
  };
  render();
</script>
