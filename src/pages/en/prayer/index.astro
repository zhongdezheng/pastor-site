---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Prayer Requests — Livingstone">
  <section class="pt-24 pb-16 px-4 sm:px-6" style="background: linear-gradient(180deg, #fefcf5 0%, #f0ece0 100%);">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal-900 text-center mb-4">Prayer</h1>
      <p class="text-center text-charcoal-600 leading-relaxed max-w-2xl mx-auto mb-10 text-sm sm:text-base">
        No distance can sever our fellowship in Christ. Whether you are walking through marketplace trials, family burdens, or a wilderness in your ministry—please leave your prayer requests here. From this harvest field, my team and I commit to standing with you daily at the altar, bearing your burdens in the Lord. You are never alone.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div class="flex justify-center">
          <iframe src="/prayer-globe.html" class="w-full max-w-[480px] aspect-square border-0" style="background:transparent;" title="Prayer Globe"></iframe>
        </div>

        <div class="w-full max-w-md mx-auto">
          <form id="prayer-form" class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-beige-200 space-y-3">
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">Name</label>
              <input type="text" name="name" placeholder="Your name (optional)" class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">Email</label>
              <input type="email" name="email" placeholder="Your email" class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">Your Country *</label>
              <input type="text" name="country" required placeholder="e.g. Kenya, Nigeria..." class="w-full px-4 py-2.5 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm">
            </div>
            <div>
              <label class="block text-xs font-medium text-charcoal-500 mb-1">Prayer Request *</label>
              <textarea name="request" rows="6" required placeholder="Share what's on your heart..." class="w-full px-4 py-3 rounded-lg border border-beige-300 bg-beige-50 focus:outline-none focus:ring-2 focus:ring-sage-400 text-charcoal-800 text-sm resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-sage-500 hover:bg-sage-600 text-white font-medium rounded-xl transition-colors">Send Prayer</button>
            <p id="prayer-error" class="text-red-500 text-xs text-center hidden"></p>
          </form>
          <div id="prayer-success" class="hidden mt-4 bg-sage-50 border border-sage-200 rounded-2xl p-6 text-center">
            <p class="text-4xl mb-2">🙏</p><p class="text-sage-600 text-sm">Your prayer has been received. We are praying for you.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const supabase = createClient(
  'https://uwebpdtjkucbcyscfzmq.supabase.co',
  'sb_publishable_TfquiTSSQip7GcF4Sodsjg_PNc_OzNl'
);

(function(){
  var f = document.getElementById('prayer-form');
  if (!f) return;
  var s = document.getElementById('prayer-success');
  var err = document.getElementById('prayer-error');
  var b = f.querySelector('button');

  f.addEventListener('submit', async function(e) {
    e.preventDefault();
    var d = new FormData(f);
    var country = (d.get('country')||'').trim();
    var request = (d.get('request')||'').trim();
    if (!country || !request) return;

    b.textContent = 'Sending...';
    b.disabled = true;
    err.classList.add('hidden');

    try {
      var { error } = await supabase.from('prayer_requests').insert({
        name: d.get('name')||'',
        email: d.get('email')||'',
        country: country,
        request: request,
        lang: 'en'
      });
      if (error) throw error;
      f.classList.add('hidden');
      s.classList.remove('hidden');
    } catch(e) {
      err.textContent = 'Something went wrong. Please try again.';
      err.classList.remove('hidden');
    } finally {
      b.textContent = 'Send Prayer';
      b.disabled = false;
    }
  });
})();
</script>
