---
// Free tools overview page (推广方案 §03) · 2026-11-11
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Free Tools for Churches — by a Pastor | Livingstone" description="Prayer list, sermon notes, Bible study worksheet, reading plan and more — 8 free church tools built by a working pastor in China. Local-first, no data uploaded.">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">Free Tools</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">Built by a Pastor, Used by His Church</h1>
      <p class="text-charcoal-600 text-lg mb-12">I'm Jeff — a pastor in China who also works at a factory. These 8 small tools ran in my own church first; only then did I feel right sharing them. All free, and your data never leaves your device.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href="/en/tools/prayer-list/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Prayer List Manager</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Prayer items · answer tracking · printable lists</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/sermon-notes/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Sermon Notes</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Sermon points, scriptures and applications, saved forever</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/bible-worksheet/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Bible Study Worksheet</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Structured Observation-Interpretation-Application</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/reading-plan/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Reading Plan Generator</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Custom range with your own start date</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/verse-memorizer/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Scripture Memorizer</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Progressive keyword-hiding memorization</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/church-poster/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Church Poster Maker</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Service and holiday poster templates</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/church-calendar/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Church Season Calendar</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Advent, Christmas and Easter, auto-computed</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
        <a href="/en/tools/roster/" class="group bg-white rounded-2xl border border-beige-200 p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-serif font-bold text-charcoal-800 group-hover:text-sage-700 transition-colors">Serving Roster</h2>
            <span class="text-sage-600 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-charcoal-500 text-sm">Worship, usher and AV rosters with conflict warnings</p>
          <p class="text-charcoal-400 text-xs mt-3">✓ Free · Runs locally</p>
        </a>
      </div>

      <div class="bg-charcoal-800 rounded-2xl p-7 text-white mt-12">
        <h2 class="text-lg font-serif font-bold mb-2">Subscribe to Jeff's tools & devotional newsletter</h2>
        <p class="text-charcoal-200 text-sm mb-5">New tools and tips, one email a month. No ads, ever.</p>
        <form id="sub-form" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="text" name="name" required maxlength="100" placeholder="Your name" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <input type="text" name="contact" required maxlength="200" placeholder="WhatsApp / Email" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <button type="submit" class="bg-sage-600 hover:bg-sage-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">Subscribe</button>
        </form>
        <p id="sub-msg" class="hidden text-sage-300 text-sm mt-3"></p>
      </div>
    </div>
  </section>

  <script>
    (function(){
      var f = document.getElementById('sub-form');
      var msg = document.getElementById('sub-msg');
      if (!f) return;
      f.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(f);
        fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ website: fd.get('website') || '', name: fd.get('name'), contact: fd.get('contact'), materials: ['newsletter'], message: 'Newsletter signup (tools page)', lang: 'en' }) })
        .then(function(r){ return r.json(); }).then(function(d){
          msg.textContent = d && d.success ? 'Got it! Jeff will be in touch soon.' : 'Something went wrong — please try again or email directly.';
          msg.classList.remove('hidden');
          if (d && d.success) f.reset();
        }).catch(function(){
          msg.textContent = 'Something went wrong — please try again or email directly.';
          msg.classList.remove('hidden');
        });
      });
    })();
  </script>
</BaseLayout>
