---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
const toolUrl = "__TOOL_URL__";
const isZh = false;
const t = { kicker: "Free Tool", use: "Open Tool", soon: "Coming soon to the Chrome Web Store", local: "Runs locally · No data uploaded", free: "Completely free", by: "Built by Jeff, a working pastor in China — used weekly in his own church", sub: "Subscribe to Jeff's tools & devotional newsletter", subDesc: "New tools, tips and a monthly email. No ads, ever.", namePh: "Your name", contactPh: "WhatsApp / Email", btn: "Subscribe", ok: "Got it! Jeff will be in touch soon.", err: "Something went wrong — please try again or email directly." };
---
<BaseLayout lang="en" title="Free Tool — Bible Study Worksheet | Livingstone" description="Structured Observation-Interpretation-Application worksheet for Bible study. Export and print.">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">Free Tool</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">Bible Study Worksheet</h1>
      <p class="text-charcoal-600 text-lg mb-8">Structured Observation-Interpretation-Application worksheet for Bible study. Export and print.</p>
      <div class="flex flex-wrap gap-3 mb-4">
        <span class="text-xs font-medium px-3 py-1 rounded-full bg-sage-100 text-sage-800 border border-sage-200">✓ Completely free</span>
        <span class="text-xs font-medium px-3 py-1 rounded-full bg-beige-100 text-charcoal-600 border border-beige-200">🔒 Runs locally · No data uploaded</span>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-beige-200 p-6 mb-10">
        <p class="text-charcoal-500 text-sm italic mb-5">Built by Jeff, a working pastor in China — used weekly in his own church</p>
        <p id="soon-note" class="text-charcoal-400 text-xs">Coming soon to the Chrome Web Store</p>
      </div>

      <div class="bg-charcoal-800 rounded-2xl p-7 text-white">
        <h2 class="text-lg font-serif font-bold mb-2">Subscribe to Jeff's tools & devotional newsletter</h2>
        <p class="text-charcoal-200 text-sm mb-5">New tools, tips and a monthly email. No ads, ever.</p>
        <form id="sub-form" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="text" name="name" required maxlength="100" placeholder="Your name" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <input type="text" name="contact" required maxlength="200" placeholder="WhatsApp / Email" class="px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-beige-100 placeholder-charcoal-400 text-sm focus:outline-none focus:border-sage-400" />
          <button type="submit" class="bg-sage-600 hover:bg-sage-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">Subscribe</button>
        </form>
        <p id="sub-msg" class="hidden text-sage-300 text-sm mt-3"></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var f = document.getElementById('sub-form');
      var msg = document.getElementById('sub-msg');
      if (!f) return;
      f.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(f);
        var isZh = document.documentElement.lang === 'zh';
        fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            website: fd.get('website') || '',
            name: fd.get('name'),
            contact: fd.get('contact'),
            materials: ['newsletter'],
            message: isZh ? '订阅工具与灵修通讯' : 'Subscribe to tools & devotional newsletter',
            lang: isZh ? 'zh' : 'en'
          })
        }).then(function(r) { return r.json(); }).then(function(d) {
          var m = document.getElementById('sub-msg');
          m.textContent = d && d.success ? "Got it! Jeff will be in touch soon." : "Something went wrong — please try again or email directly.";
          m.classList.remove('hidden');
          if (d && d.success) f.reset();
        }).catch(function() {
          var m = document.getElementById('sub-msg');
          m.textContent = "Something went wrong — please try again or email directly.";
          m.classList.remove('hidden');
        });
      });
    })();
  </script>
</BaseLayout>
