---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Give — Livingstone">
  <section class="pt-24 pb-16 px-4 sm:px-6 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-serif text-3xl font-bold text-charcoal-800 mb-3">Give &amp; Support</h1>
      <p class="text-charcoal-500 mb-8 text-sm max-w-xl mx-auto">We invite you to become a Kingdom partner in this harvest field. Use your financial resources to co-labor across the marketplace and the entire world, bringing down God's culture as we witness His unshakable Kingdom together!</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        <div class="bg-beige-50 rounded-2xl p-6 border border-beige-200 hover:shadow-lg transition-shadow cursor-pointer" onclick="selectAmount(10)">
          <p class="text-3xl font-bold text-charcoal-800">$10</p>
          <p class="text-xs text-charcoal-400 mt-1">One-time Gift</p>
        </div>
        <div class="bg-beige-50 rounded-2xl p-6 border border-beige-200 hover:shadow-lg transition-shadow cursor-pointer" onclick="selectAmount(50)">
          <p class="text-3xl font-bold text-charcoal-800">$50</p>
          <p class="text-xs text-charcoal-400 mt-1">Monthly Support</p>
        </div>
        <div class="bg-beige-50 rounded-2xl p-6 border border-beige-200 hover:shadow-lg transition-shadow cursor-pointer" onclick="selectAmount(100)">
          <p class="text-3xl font-bold text-charcoal-800">$100</p>
          <p class="text-xs text-charcoal-400 mt-1">Generous Gift</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border p-6 max-w-sm mx-auto">
        <label class="text-sm font-semibold text-charcoal-600 mb-2 block">Custom Amount</label>
        <div class="flex gap-2 mb-4">
          <span class="text-xl font-bold text-charcoal-400 self-center">$</span>
          <input type="number" id="give-amount" value="10" min="1" class="flex-1 text-2xl font-bold text-charcoal-800 border-b-2 border-charcoal-300 focus:border-charcoal-600 outline-none text-center bg-transparent py-2">
        </div>
        <div class="text-left space-y-3 mb-4">
          <input type="text" id="give-name" placeholder="Your Name" class="w-full px-3 py-2 border rounded-lg text-sm">
          <input type="email" id="give-email" placeholder="Email" class="w-full px-3 py-2 border rounded-lg text-sm">
          <textarea id="give-note" rows="2" placeholder="Message or prayer request..." class="w-full px-3 py-2 border rounded-lg text-sm"></textarea>
        </div>
        <button class="w-full py-3 bg-charcoal-800 hover:bg-charcoal-700 text-white rounded-xl font-medium text-sm transition-colors" onclick="submitGive()">Continue with PayPal</button>
      </div>
      
    </div>
  </section>
</BaseLayout>

<script is:inline>
  function selectAmount(amt){document.getElementById('give-amount').value=amt;}
  function submitGive(){
    var a=document.getElementById('give-amount').value,n=document.getElementById('give-name').value.trim(),e=document.getElementById('give-email').value.trim(),m=document.getElementById('give-note').value.trim();
    var lines=['I would like to give $'+a,'Name: '+n,'Email: '+e,'Message: '+m,'Payment: PayPal'];
    window.open('https://www.paypal.com/paypalme/pastorjeffinchina/'+a,'_blank');
  }
</script>
</BaseLayout>
