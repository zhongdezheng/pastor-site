---
/**
 * 📍 文件位置: src/pages/en/faq/index.astro
 * 🌐 路由: /en/faq/
 * 🎯 作用: 英文 FAQ——15 个批发买家高频问题（材质/品质/定制/打样/运输）
 * 🔧 修改指南: 直接改下方 categories 数组；新增问答往对应类目 items 里加 {q, a}
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';

const categories = [
  { name: 'Orders & Shopping', items: [
    { q: 'How do I place an order?', a: "Browse the products page, pick your color and size, and add to cart — or use the custom designer to upload your own artwork. Jeff will confirm the details with you via WhatsApp or email after you submit the order." },
    { q: 'What payment methods do you accept?', a: "We accept PayPal and common international payment methods. A payment link will be sent after you place your order; production and shipping start once payment is confirmed." },
    { q: 'Do you take custom orders?', a: "Yes. The custom designer lets you upload images and add text with a live preview. For group orders (church tees, event apparel), contact Jeff directly to work out a plan." },
  ]},
  { name: 'Shipping & Logistics', items: [
    { q: 'How long does shipping take?', a: "In-stock items ship shortly after your order is confirmed. International delivery usually takes 7–15 days depending on destination; tracking will be shared once shipped." },
    { q: 'How do I track my order?', a: "Sign in to your account page to view order history and status. Tracking info is shared when your order ships." },
  ]},
  { name: 'After-sales & Contact', items: [
    { q: 'What if there is a problem with my order?', a: "Contact Jeff directly — if something goes wrong, he fixes it before you ask. After-sales issues get a response within 24 hours." },
    { q: 'How do I reach you?', a: "WhatsApp, email, or the contact form on the site — replies within 24 hours, usually sooner." },
  ]},
];
---

<BaseLayout lang="en" title="FAQ | Livingstone" description="Common questions about ordering, shipping and after-sales on this site.">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">Wholesale FAQ</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">Frequently Asked Questions</h1>
      <p class="text-charcoal-600 text-lg mb-10">Ordering, shipping and after-sales — the questions we hear most, answered in one place.</p>

      {categories.map(cat => (
        <div class="mb-10">
          <h2 class="text-sm uppercase tracking-widest text-charcoal-400 font-semibold mb-3">{cat.name}</h2>
          <div class="space-y-3">
            {cat.items.map(item => (
              <details class="group bg-white rounded-xl border border-beige-200 shadow-sm open:shadow-md transition-shadow">
                <summary class="flex items-start justify-between gap-4 cursor-pointer p-5 font-medium text-charcoal-800 text-sm md:text-base list-none [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span class="text-sage-700 font-serif text-xl leading-none group-open:rotate-45 transition-transform flex-shrink-0">+</span>
                </summary>
                <div class="px-5 pb-5 -mt-1 text-charcoal-600 text-sm leading-relaxed whitespace-pre-line">{item.a}</div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="bg-charcoal-800 rounded-2xl p-8 text-white mt-12">
        <h2 class="text-lg font-serif font-bold mb-2">Still have questions?</h2>
        <p class="text-charcoal-200 text-sm mb-5">Message Jeff directly — real answers within 24 hours, usually much faster.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/8613602812927" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-medium text-sm px-5 py-3 rounded-xl transition-colors">WhatsApp Jeff</a>
          <a href="/en/products/" class="inline-flex items-center gap-2 border border-charcoal-500 hover:border-charcoal-300 text-charcoal-100 font-medium text-sm px-5 py-3 rounded-xl transition-colors">Browse the store</a>
          <a href="/en/testimonies/" class="inline-flex items-center gap-2 border border-charcoal-500 hover:border-charcoal-300 text-charcoal-100 font-medium text-sm px-5 py-3 rounded-xl transition-colors">About Jeff</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
