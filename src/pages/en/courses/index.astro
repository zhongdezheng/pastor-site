---
/**
 * 📍 文件位置: src/pages/en/courses/index.astro
 * 🌐 路由: /en/courses/
 * 🎯 作用: 英文圣经学习课程列表 — 从管理后台 API 获取课程数据
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';

// ⚡ 构建时从管理后台 API 获取课程，失败则回退本地 JSON
let courses = [];
try {
  const res = await fetch('http://localhost:5200/api/courses');
  if (res.ok) {
    courses = (await res.json())
      .filter(c => c.status === 1)
      .map(c => ({
        id: c.id,
        title: { en: c.title_en || '', zh: c.title_zh || '' },
        description: { en: c.description_en || '', zh: c.description_zh || '' },
        icon: c.icon || '📖',
        level: c.level || '',
        lessons: c.lessons || 0,
        is_free: Boolean(c.is_free),
      }));
  }
} catch(e) {}
if (!courses.length) {
  courses = (await import('../../../content/courses.json')).default;
}
---

<BaseLayout lang="en" title="Bible Study & Faith Courses | Livingstone">
  <section class="pt-24 pb-16 px-4 sm:px-6 bg-beige-50 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <h1 class="font-serif text-3xl font-bold text-charcoal-800 mb-3 text-center">Bible Study Courses</h1>
      <p class="text-charcoal-500 mb-10 text-center text-sm">Deepen your faith through guided study and reflection.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {courses.map(c => (
          <div class="bg-white rounded-2xl border p-6 hover:shadow-lg transition-shadow">
            <span class="text-3xl">{c.icon}</span>
            <h3 class="font-serif text-lg font-bold text-charcoal-800 mt-3">{c.title.en}</h3>
            <p class="text-xs text-charcoal-400 mt-1">{c.description.en}</p>
            <div class="flex gap-2 mt-3">
              <span class="text-[10px] bg-beige-100 px-2 py-0.5 rounded-full">{c.level}</span>
              <span class="text-[10px] bg-beige-100 px-2 py-0.5 rounded-full">{c.lessons} Lessons</span>
              <span class="text-[10px] bg-beige-100 px-2 py-0.5 rounded-full">{c.is_free ? 'Free' : 'Paid'}</span>
            </div>
            <button class="mt-4 px-4 py-2 bg-charcoal-800 text-white text-xs rounded-lg hover:bg-charcoal-700" onclick={`enrollWhatsApp('${c.title.en.replace(/'/g, "\\'")}')`}>Enroll via WhatsApp</button>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>function enrollWhatsApp(c){window.open('https://wa.me/85297094785?text='+encodeURIComponent('Hi! I would like to enroll in: '+c),'_blank');}</script>