<!-- ====== 内联 JS（is:inline 确保不被 Astro 打包处理，原样保留在 HTML 中） ====== -->
<script is:inline>
  // 移动端菜单切换：点击汉堡按钮显示/隐藏下拉菜单，同时切换图标
  document.getElementById('menu-toggle').onclick = function() {
    var menu = document.getElementById('mobile-menu');
    var open = document.getElementById('menu-icon-open');
    var close = document.getElementById('menu-icon-close');
    menu.classList.toggle('hidden');
    open.classList.toggle('hidden');
    close.classList.toggle('hidden');
  };

  // 购物车角标初始化：从 localStorage 读取购物车数据，更新浮窗上的数字角标
  (function(){
    // ps-cart 是购物车数据在 localStorage 中的 key
    var c = JSON.parse(localStorage.getItem('ps-cart') || '[]');
    // 累加所有商品数量
    var n = c.reduce(function(s, i) { return s + i.quantity; }, 0);
    var b = document.getElementById('cart-badge-main');
    // 有商品时显示角标，否则隐藏
    if (b && n > 0) { b.textContent = n; b.classList.remove('hidden'); }
  })();
</script>

<script is:inline>
(function(){
  fetch("/api/site-config").then(function(r){return r.json()}).then(function(d){
    if(!d.ok||!d.data)return; var s=d.data;
    var wa=document.getElementById("wa-btn");
    if(wa&&s.site_whatsapp) wa.href="https://wa.me/"+s.site_whatsapp.replace(/\D/g,"");
    var em=document.querySelector("footer p:last-of-type");
    if(em&&s.site_email) em.textContent=s.site_email;
  });
})();
</script>
