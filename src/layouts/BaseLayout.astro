---
import siteData from '../content/site.json';
const { site } = siteData;
interface Props {
  lang: 'en' | 'zh';
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const otherLang = lang === 'en' ? 'zh' : 'en';
const otherPath = `/${otherLang}/`;
const labels = {
  en: { home: 'Home', products: 'Products', prayer: 'Prayer', contact: 'Contact', langSwitch: '中文' },
  zh: { home: '首页', products: '产品', prayer: '代祷', contact: '联系', langSwitch: 'English' },
};
const t = labels[lang];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title || site.name[lang]}</title>
  <meta name="description" content={description || site.tagline[lang]} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <nav class="fixed top-0 left-0 right-0 z-40 bg-cream-50/90 backdrop-blur-md border-b border-cream-200/50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href={`/${lang}/`} class="font-serif text-xl font-bold text-clay-800 tracking-tight">
        ✝ {site.name[lang]}
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-clay-500">
        <a href={`/${lang}/`} class="hover:text-clay-800 transition-colors">{t.home}</a>
        <a href={`/${lang}/products/`} class="hover:text-clay-800 transition-colors">{t.products}</a>
        <a href={`/${lang}/prayer/`} class="hover:text-clay-800 transition-colors">{t.prayer}</a>
        <a href={`/${lang}/contact/`} class="hover:text-clay-800 transition-colors">{t.contact}</a>
        <a href={otherPath} class="ml-4 px-4 py-1.5 border border-clay-300 rounded-full text-xs text-clay-500 hover:text-clay-700 hover:border-clay-400 transition-colors">
          {t.langSwitch}
        </a>
      </div>
      <a href={otherPath} class="md:hidden text-sm text-clay-500">{t.langSwitch}</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="bg-clay-900 text-cream-300 py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-serif text-2xl font-bold text-cream-100 mb-2">✝ {site.name[lang]}</p>
      <p class="text-sm text-cream-500 mb-8">{site.tagline[lang]}</p>
      <div class="flex justify-center gap-8 text-sm mb-8">
        <a href={`/${lang}/`} class="hover:text-cream-100 transition-colors">{t.home}</a>
        <a href={`/${lang}/products/`} class="hover:text-cream-100 transition-colors">{t.products}</a>
        <a href={`/${lang}/prayer/`} class="hover:text-cream-100 transition-colors">{t.prayer}</a>
        <a href={`/${lang}/contact/`} class="hover:text-cream-100 transition-colors">{t.contact}</a>
      </div>
      <p class="text-xs text-cream-600">
        &copy; {new Date().getFullYear()} {site.name.en}. {
          lang === 'en'
            ? '"Love one another as I have loved you." — John 15:12'
            : '「你们要彼此相爱，像我爱你们一样。」— 约翰福音 15:12'
        }
      </p>
    </div>
  </footer>

  <!-- WhatsApp Floating Button -->
  <a
    href={`https://wa.me/${site.whatsapp}?text=${lang === 'en' ? 'Hi! I visited your website and would like to know more.' : '你好！我访问了你的网站，想了解更多。'}`}
    target="_blank" rel="noopener"
    id="wa-btn"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 hover:bg-green-400 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110"
    aria-label="WhatsApp"
  >
    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
  </a>
</body>
</html>
