---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import staticProds from '../../../../features/products/products.json';

export async function getStaticPaths() {
  let products = [];
  try {
    const res = await fetch('http://localhost:5200/api/products');
    if (res.ok) {
      const raw = await res.json();
      products = raw.filter(p => p.status === 1 && p.deleted === 0).map(p => ({
        id: String(p.id), category: p.category_id === 1 ? 'apparel' : 'accessories',
        name: { en: p.name_en || '', zh: p.name_zh || '' }, price: p.price || 0,
        colors: JSON.parse(p.colors || '[]'), sizes: JSON.parse(p.sizes || '[]'),
        images: JSON.parse(p.images || '[]'),
        details: { en: p.description_en || '', zh: p.description_zh || '' },
      }));
    }
  } catch(e) {}
  if (!products.length) products = staticProds;
  return products.map(p => ({ params: { slug: p.id } }));
}
---

<BaseLayout lang="zh" title="产品 | 恩典之约">
  <section class="pt-24 pb-16 px-4 sm:px-6 bg-white min-h-screen">
    <div class="max-w-5xl mx-auto text-center">
      <a href="/zh/products/" class="inline-block text-sm text-charcoal-500 hover:text-charcoal-700 mb-6">&larr; 返回</a>
      <h1 class="font-serif text-2xl font-bold text-charcoal-800 mb-4">产品详情</h1>
      <p class="text-charcoal-400 mb-8">加载中...</p>
    </div>
  </section>

  <script is:inline>
    (async function() {
      var slug = window.location.pathname.split('/').filter(Boolean).pop();
      try {
        var r = await fetch('https://admin.pastorjeffnchina.com/api/products');
        if (!r.ok) throw new Error('API error');
        var raw = await r.json();
        var prods = raw.filter(function(p) { return p.status === 1 && p.deleted === 0; }).map(function(p) {
          return {
            id: String(p.id), name: { en: p.name_en || '', zh: p.name_zh || '' }, price: p.price || 0,
            colors: JSON.parse(p.colors || '[]'), sizes: JSON.parse(p.sizes || '[]'),
            images: JSON.parse(p.images || '[]'),
            details: { en: p.description_en || '', zh: p.description_zh || '' },
          };
        });
        var prod = prods.find(function(p) { return p.id === slug; });
        if (!prod) { document.querySelector('h1').textContent = '产品未找到'; return; }
        renderDetail(prod);
      } catch(e) { document.querySelector('p').textContent = '加载失败，请刷新重试。'; }
    })();

    function renderDetail(p) {
      var lang = 'zh';
      var t = {return:'返回', color:'颜色', sizes:'尺码', qty:'数量', addCart:'加入购物车', buyNow:'立即购买', details:'商品详情', care:'洗涤保养', design:'定制设计'};
      document.title = (p.name.zh || p.name.en) + ' | 恩典之约';
      var cm = {'白色':'#f0f0f0','黑色':'#222','灰色':'#999','深蓝':'#1e3a5f','米白':'#f5f0e8','粉色':'#ffb6c1','杏色':'#f5deb3','红色':'#dc2626','浅灰色':'#d1d5db'};

      var html = '<a href="/zh/products/" class="inline-block text-sm text-charcoal-500 hover:text-charcoal-700 mb-6">&larr; ' + t.return + '</a>' +
        '<div class="flex flex-col md:flex-row gap-8">' +
        '<div class="md:w-1/2"><div class="aspect-square bg-beige-50 rounded-2xl flex items-center justify-center overflow-hidden">' +
        (p.images && p.images[0] ? '<img id="main-img" src="' + p.images[0] + '" alt="" class="w-full h-full object-contain" />' : '<span class="text-6xl">👕</span>') +
        '</div>' + (p.images && p.images.length > 1 ? '<div class="flex gap-2 mt-3 overflow-x-auto" id="thumbs">' + p.images.map(function(img, i) {
          return '<div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 cursor-pointer border-2 transition-colors ' + (i===0?'border-charcoal-600':'border-transparent') + '" onclick="var m=document.getElementById(\'main-img\');m.src=\'' + img + '\';document.querySelectorAll(\'#thumbs > div\').forEach(function(d,j){d.classList.toggle(\'border-charcoal-600\',j===' + i + ')})"><img src="' + img + '" alt="" class="w-full h-full object-cover" /></div>';
        }).join('') + '</div>' : '') + '</div>' +
        '<div class="md:w-1/2"><h1 class="font-serif text-2xl font-bold text-charcoal-800">' + (p.name.zh || p.name.en) + '</h1>' +
        '<p class="text-2xl font-bold text-red-500 mt-2">$' + p.price.toFixed(2) + ' USD</p>' +
        '<div class="mt-5"><span class="text-xs font-semibold text-charcoal-500 uppercase tracking-wide">' + t.color + '</span><div class="flex gap-2 mt-1.5">' + p.colors.map(function(c,i) { return '<div class="w-8 h-8 rounded-full border-2 cursor-pointer ' + (i===0?'border-charcoal-800':'border-charcoal-300') + '" style="background:' + (cm[c]||c) + '" data-color="' + c + '" onclick="selColor=\'' + c + '\';document.querySelectorAll(\'[data-color]\').forEach(function(e){e.classList.toggle(\'border-charcoal-800\',e.dataset.color===\'' + c + '\')})"></div>'; }).join('') + '</div></div>' +
        '<div class="mt-4"><span class="text-xs font-semibold text-charcoal-500 uppercase tracking-wide">' + t.sizes + '</span><div class="flex flex-wrap gap-1.5 mt-1.5">' + p.sizes.map(function(s,i) { return '<div class="sz-btn px-3 py-1.5 border rounded-lg text-sm cursor-pointer font-medium ' + (i===0?'bg-charcoal-800 text-white border-charcoal-800':'border-charcoal-300 text-charcoal-600') + '" data-size="' + s + '" onclick="selSize=\'' + s + '\';document.querySelectorAll(\'.sz-btn\').forEach(function(e){e.classList.remove(\'bg-charcoal-800\',\'text-white\',\'border-charcoal-800\');e.classList.add(\'border-charcoal-300\',\'text-charcoal-600\')});this.classList.add(\'bg-charcoal-800\',\'text-white\',\'border-charcoal-800\');this.classList.remove(\'border-charcoal-300\',\'text-charcoal-600\')">' + s + '</div>'; }).join('') + '</div></div>' +
        '<div class="flex items-center gap-3 mt-4"><span class="text-xs font-semibold text-charcoal-500 uppercase tracking-wide">' + t.qty + '</span><button onclick="qty=Math.max(1,qty-1);document.getElementById(\'qty-val\').textContent=qty" class="w-8 h-8 border border-charcoal-300 rounded-full text-sm">−</button><span id="qty-val" class="w-6 text-center font-bold">1</span><button onclick="qty++;document.getElementById(\'qty-val\').textContent=qty" class="w-8 h-8 border border-charcoal-300 rounded-full text-sm">+</button></div>' +
        '<button onclick="location.href=\'/zh/designer/\'" class="w-full mt-5 py-2.5 bg-[#c9a84c] hover:bg-[#b89336] text-white rounded-xl font-medium text-sm transition-colors">' + t.design + '</button>' +
        '<button onclick="addToCart(\'' + p.id + '\',\'' + (p.name.zh||p.name.en).replace(/'/g,'\\\'') + '\',' + p.price + ',\'' + (p.images?.[0]||'') + '\')" class="w-full mt-5 py-2.5 bg-charcoal-800 hover:bg-charcoal-700 text-white rounded-xl font-medium text-sm transition-colors">' + t.addCart + '</button>' +
        '<button onclick="addToCart(\'' + p.id + '\',\'' + (p.name.zh||p.name.en).replace(/'/g,'\\\'') + '\',' + p.price + ',\'' + (p.images?.[0]||'') + '\');location.href=\'/zh/cart/\'" class="w-full mt-2 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium text-sm transition-colors">' + t.buyNow + '</button>' +
        '<div class="mt-6 pt-6 border-t border-beige-200"><h3 class="font-serif text-lg font-bold text-charcoal-800 mb-2">' + t.details + '</h3><div class="text-sm text-charcoal-500 leading-relaxed whitespace-pre-line">' + (p.details.zh || '') + '</div></div>' +
        '<div class="mt-4"><h3 class="font-serif text-lg font-bold text-charcoal-800 mb-2">' + t.care + '</h3><p class="text-sm text-charcoal-500">可手洗或机洗。不可漂白。不要长时间浸泡。洗涤液温度不超过45°C。</p><p class="text-sm text-charcoal-500 mt-1">平铺测量，误差2-4cm属正常现象。</p></div>' +
        '</div></div>';

      var section = document.querySelector('section');
      section.querySelector('.max-w-5xl').innerHTML = html;

      var cartBtn = document.createElement('a');
      cartBtn.href = '/zh/cart/';
      cartBtn.id = 'cart-floating';
      cartBtn.className = 'fixed bottom-24 right-6 z-50 w-14 h-14 bg-charcoal-800 hover:bg-charcoal-700 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110';
      cartBtn.innerHTML = '<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg><span id="cart-badge" class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold hidden">0</span>';
      document.body.appendChild(cartBtn);
      updateBadge();
    }

    var selColor = '', selSize = '', qty = 1;
    function addToCart(id, name, price, img) {
      var c = JSON.parse(localStorage.getItem('ps-cart')||'[]'), x = c.find(function(i) { return i.id===id && i.color===selColor && i.size===selSize; });
      if(x) x.quantity += qty; else c.push({id:id,slug:id,name:name,price:price,color:selColor||'默认',size:selSize||'均码',quantity:qty,image:img});
      localStorage.setItem('ps-cart',JSON.stringify(c)); updateBadge();
    }
    function updateBadge() {
      var c = JSON.parse(localStorage.getItem('ps-cart')||'[]'), n = c.reduce(function(s,i) { return s+i.quantity; },0), b = document.getElementById('cart-badge');
      if (b) { if(n>0) { b.textContent = n; b.classList.remove('hidden'); } else b.classList.add('hidden'); }
    }
  </script>
</BaseLayout>
