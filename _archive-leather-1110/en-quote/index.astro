---
/**
 * 📍 文件位置: src/pages/en/quote/index.astro
 * 🌐 路由: /en/quote/
 * 🎯 作用: 免费色卡/询价表单（线索捕获）——提交到 /api/leads，D1 leads 表
 * 🔧 修改指南:
 *   - 表单字段改这里 + 提交 payload；后端字段校验在 functions/api/leads.js
 *   - 线索在管理后台「线索管理」Tab 查看
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
const series = [
  { v: 'QL Premium Nappa', label: 'QL Premium Nappa — 1.2mm microfiber' },
  { v: 'GH Yunrou Classic', label: 'GH Yunrou Classic — soft-touch' },
  { v: 'GD Original Senna', label: 'GD Original Senna grain' },
  { v: 'QE Mercedes-Benz Brushed', label: 'QE Mercedes-Benz brushed grain' },
  { v: 'Comfort Suede', label: 'Comfort Suede (Alcantara-style)' },
  { v: 'NP Napa PVC', label: 'NP Napa PVC — 30+ colors' },
  { v: 'Genuine Leather', label: 'Premium Genuine Nappa — top grain' },
  { v: 'Custom Seat Covers', label: 'Custom model-specific seat covers' },
];
---

<BaseLayout lang="en" title="Free Color Cards & Quote — Auto Interior Leather | Livingstone" description="Request free color cards and a wholesale quote for automotive interior leather — microfiber, PVC, suede, genuine. Reply within 24 hours.">
  <section class="py-24 lg:py-32 px-6 bg-beige-50 min-h-screen">
    <div class="max-w-2xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-sage-600 font-semibold mb-4">Free Color Cards &amp; Quote</p>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-charcoal-900 mb-4">Get color cards and a wholesale quote</h1>
      <p class="text-charcoal-600 text-lg mb-10">Tell us what you need — Jeff replies within 24 hours, usually much faster. Color cards ship worldwide, you only cover the courier.</p>

      <form id="lead-form" class="bg-white rounded-2xl shadow-lg border border-beige-200 p-8 space-y-5">
        <!-- 蜜罐反垃圾：对真实用户隐藏 -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div>
          <label for="f-name" class="block text-sm font-medium text-charcoal-700 mb-1">Your name <span class="text-red-500">*</span></label>
          <input id="f-name" name="name" required maxlength="100" class="w-full rounded-xl border border-beige-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-sage-400" placeholder="John Smith" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="f-company" class="block text-sm font-medium text-charcoal-700 mb-1">Company / Shop</label>
            <input id="f-company" name="company" maxlength="200" class="w-full rounded-xl border border-beige-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-sage-400" placeholder="Smith Auto Upholstery" />
          </div>
          <div>
            <label for="f-country" class="block text-sm font-medium text-charcoal-700 mb-1">Country</label>
            <input id="f-country" name="country" maxlength="100" class="w-full rounded-xl border border-beige-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-sage-400" placeholder="United States" />
          </div>
        </div>
        <div>
          <label for="f-contact" class="block text-sm font-medium text-charcoal-700 mb-1">WhatsApp number or email <span class="text-red-500">*</span></label>
          <input id="f-contact" name="contact" required maxlength="200" class="w-full rounded-xl border border-beige-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-sage-400" placeholder="+1 555 123 4567 or you@shop.com" />
        </div>
        <div>
          <span class="block text-sm font-medium text-charcoal-700 mb-2">Interested in (optional)</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {series.map(s => (
              <label class="flex items-center gap-2 p-2.5 rounded-lg border border-beige-300 cursor-pointer hover:bg-beige-100 transition-colors">
                <input type="checkbox" name="materials" value={s.v} class="rounded border-beige-300 text-charcoal-700 focus:ring-sage-400" />
                <span class="text-xs text-charcoal-600">{s.label}</span>
              </label>
            ))}
          </div>
        </div>
        <div>
          <label for="f-message" class="block text-sm font-medium text-charcoal-700 mb-1">Message (optional)</label>
          <textarea id="f-message" name="message" rows="4" maxlength="5000" class="w-full rounded-xl border border-beige-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-sage-400" placeholder="e.g. I need seat leather for 2018-2023 trucks, about 200 meters to start..."></textarea>
        </div>

        <p id="form-error" class="hidden text-red-600 text-sm"></p>
        <button id="form-submit" type="submit" class="w-full bg-charcoal-800 hover:bg-charcoal-700 text-white font-medium py-3.5 rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
          Request free color cards
        </button>
        <p class="text-charcoal-400 text-xs text-center">No spam. Your details go straight to Jeff — not a mailing list.</p>
      </form>

      <div id="form-success" class="hidden bg-white rounded-2xl shadow-lg border border-beige-200 p-10 text-center mt-8">
        <div class="w-14 h-14 rounded-full bg-sage-100 text-sage-800 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h2 class="text-xl font-serif font-bold text-charcoal-900 mb-2">Got it — thank you!</h2>
        <p class="text-charcoal-600 text-sm mb-6">Jeff will reply within 24 hours. Want it faster? Message him on WhatsApp now.</p>
        <a href="https://wa.me/8613602812927" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-medium text-sm px-5 py-3 rounded-xl transition-colors">WhatsApp Jeff now</a>
      </div>

      <p class="text-center mt-8"><a href="/en/marketplace/" class="text-charcoal-400 hover:text-sage-600 text-sm transition-colors">← Back to Marketplace</a></p>
    </div>
  </section>

  <script>
    const form = document.getElementById('lead-form');
    const errBox = document.getElementById('form-error');
    const btn = document.getElementById('form-submit');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      btn.disabled = true; btn.textContent = 'Sending...';
      const fd = new FormData(form);
      const payload = {
        name: fd.get('name') || '',
        company: fd.get('company') || '',
        country: fd.get('country') || '',
        contact: fd.get('contact') || '',
        materials: fd.getAll('materials'),
        message: fd.get('message') || '',
        website: fd.get('website') || '',
        lang: 'en',
      };
      try {
        const res = await fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const d = await res.json();
        if (res.ok && (d.success || d.id)) {
          form.classList.add('hidden');
          document.getElementById('form-success').classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          errBox.textContent = d.error || 'Something went wrong — please WhatsApp us instead.';
          errBox.classList.remove('hidden');
          btn.disabled = false; btn.textContent = 'Request free color cards';
        }
      } catch (err) {
        errBox.textContent = 'Network error — please try again or WhatsApp us.';
        errBox.classList.remove('hidden');
        btn.disabled = false; btn.textContent = 'Request free color cards';
      }
    });
  </script>
</BaseLayout>
